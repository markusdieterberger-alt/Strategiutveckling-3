//@version=6
indicator("Bucko Replica V3 | research 03.1 | OHLCV", overlay=true, max_boxes_count=100, max_labels_count=200, max_lines_count=100, max_bars_back=600)
// Functional research reconstruction. NOT Bucko's source, a strategy, or a profitability claim.
// ALL formulas, thresholds, weights, grading and gate rules below are REPLICA ASSUMPTION.
// Observed 2/2 settings came from a BTC settings view; applying them to MNQ is an assumption.
// Frozen specification: MODEL_SPEC.md. Closed bars only. No orders. F11 is UNKNOWN here.

string G1 = "REPLICA ASSUMPTION | structure and zones"
int leftBars = input.int(2, "Pivot left", minval=1, maxval=10, group=G1)
int rightBars = input.int(2, "Pivot right", minval=1, maxval=10, group=G1)
int maxPerKind = input.int(12, "Max zones of each kind", minval=1, maxval=20, group=G1)
int fvgLife = input.int(100, "FVG expiry, bars after formation", minval=1, maxval=500, group=G1)
int sdLife = input.int(200, "Supply/demand expiry, bars after confirmation", minval=1, maxval=500, group=G1)
bool drawBOS = input.bool(true, "Show BOS", group=G1)
bool drawSweep = input.bool(false, "Show sweep diagnostics", group=G1)
bool drawZones = input.bool(true, "Show separate FVG / supply / demand", group=G1)
string G2 = "REPLICA ASSUMPTION | score and hard gates"
int threshold = input.int(6, "Research threshold (nominal /11, only 10 price factors)", minval=1, maxval=11, group=G2)
float rvolMin = input.float(1.2, "F3 RVOL threshold", minval=0.1, step=0.1, group=G2)
float chopLimit = input.float(0.25, "CHOP if efficiency ratio 14 below", minval=0.0, maxval=1.0, step=0.05, group=G2)
string htf = input.timeframe("15", "F10 confirmed higher timeframe", group=G2)
string researchSession = input.session("0930-1600", "F9 research session, weekdays", group=G2)
string sessionTZ = input.string("America/New_York", "Research session IANA timezone", group=G2)
bool gateChop = input.bool(true, "Hard gate: reject CHOP", group=G2)
bool gateSession = input.bool(false, "Hard gate: require research session", group=G2)
bool gateTrend = input.bool(false, "Hard gate: require EMA regime alignment", group=G2)
bool requireMNQ = input.bool(true, "Hard gate: MNQ only", group=G2)
string G3 = "Display and research logging"
bool compact = input.bool(false, "Compact HUD (full mode shows each factor)", group=G3)
bool showLabels = input.bool(true, "Show raw candidates, including blocked", group=G3)
bool showLog = input.bool(true, "Show last six raw events", group=G3)
bool pineLog = input.bool(false, "Write event JSON to Pine Logs", group=G3)
bool liveAlerts = input.bool(false, "Enable research JSON alerts on raw events", group=G3)

if barstate.isfirst and (not chart.is_standard or (timeframe.period != "1" and timeframe.period != "5"))
    runtime.error("BR3 research supports standard time-based 1m or 5m candles only.")
if barstate.isfirst and timeframe.in_seconds(htf) <= timeframe.in_seconds()
    runtime.error("F10 timeframe must be strictly higher than the chart timeframe.")

type Zone
    box visual
    float lo
    float hi
    int born
    int kind
    bool touched
// kind: 1 bullish FVG; -1 bearish FVG; 2 demand; -2 supply.
var array<Zone> zones = array.new<Zone>()
f_add(float lo, float hi, int kind) =>
    color col = kind == 1 ? color.aqua : kind == -1 ? color.fuchsia : kind == 2 ? color.lime : color.orange
    string title = kind == 1 ? "FVG +" : kind == -1 ? "FVG -" : kind == 2 ? "DEMAND" : "SUPPLY"
    box b = na
    if drawZones
        b := box.new(left=bar_index, top=hi, right=bar_index+1, bottom=lo, border_color=color.new(col, 35), bgcolor=color.new(col, 90), text=title, text_color=col, text_size=size.tiny)
    array.push(zones, Zone.new(b, lo, hi, bar_index, kind, false))
    int count = 0
    for z in zones
        count += z.kind == kind ? 1 : 0
    if count > maxPerKind
        int i = 0
        while i < array.size(zones)
            Zone z = array.get(zones, i)
            if z.kind == kind
                if not na(z.visual)
                    box.delete(z.visual)
                array.remove(zones, i)
                break
            i += 1

f_pivot(bool upper) =>
    float candidate = upper ? high[rightBars] : low[rightBars]
    bool ok = not na(candidate)
    for j = 0 to leftBars + rightBars
        if j != rightBars
            float other = upper ? high[j] : low[j]
            ok := ok and not na(other) and (upper ? candidate > other : candidate < other)
    ok ? candidate : na

f_i(float x) =>
    na(x) ? 0 : int(x)
f_text(float x) =>
    na(x) ? "?" : str.tostring(int(x))
f_json(float x) =>
    na(x) ? "null" : str.tostring(x)
f_mask(array<float> a) =>
    int m = 0
    for i = 0 to array.size(a)-1
        m += f_i(array.get(a, i)) * int(math.pow(2, i))
    m
f_known(array<float> a) =>
    int n = 0
    for x in a
        n += not na(x) ? 1 : 0
    n
f_score(array<float> a) =>
    int n = 0
    for x in a
        n += f_i(x)
    n

float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)
float rsi14 = ta.rsi(close, 14)
float avgVol = ta.sma(volume, 20)[1]
float rvol = avgVol > 0 and not na(volume) ? volume / avgVol : na
float path14 = math.sum(math.abs(ta.change(close)), 14)
float er = path14 > 0 ? math.abs(close-close[14])/path14 : path14 == 0 ? 0.0 : na
float atr14 = ta.atr(14)
// Prior completed HTF bar, never the developing HTF candle. lookahead_on is paired with [1].
[htClose, htEMA, htCount, htClosedAt] = request.security(syminfo.tickerid, htf, [close[1], ta.ema(close, 50)[1], bar_index[1], time_close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
bool htKnown = not na(htClose) and not na(htEMA) and htCount >= 49
bool inSession = not na(time(timeframe.period, researchSession + ":23456", sessionTZ))
bool badOHLC = na(open) or na(high) or na(low) or na(close) or high < math.max(open, close) or low > math.min(open, close) or high < low
bool badVolume = na(volume) or volume < 0
bool gap = not na(time[1]) and time-time[1] != int(timeframe.in_seconds()*1000)
var int contiguous = 0
var float swingHi = na
var float swingLo = na
var int swingHiAt = na
var int swingLoAt = na
var bool hiBroken = false
var bool loBroken = false
var int structure = 0
float ph = f_pivot(true)
float pl = f_pivot(false)
bool bosL = false
bool bosS = false
bool sweepL = false
bool sweepS = false
bool fvgL = false
bool fvgS = false
bool sdL = false
bool sdS = false

if barstate.isconfirmed
    contiguous := badOHLC or badVolume ? 0 : gap ? 1 : contiguous+1
    if gap or badOHLC or badVolume
        for z in zones
            if not na(z.visual)
                box.delete(z.visual)
        array.clear(zones)
        swingHi := na
        swingLo := na
        swingHiAt := na
        swingLoAt := na
        hiBroken := false
        loBroken := false
        structure := 0
    if not badOHLC and not badVolume
        // Evaluate previously confirmed structure BEFORE introducing this bar's new pivots.
        bosL := not na(swingHi) and not hiBroken and close > swingHi
        bosS := not na(swingLo) and not loBroken and close < swingLo
        sweepL := not na(swingLo) and low < swingLo and close > swingLo
        sweepS := not na(swingHi) and high > swingHi and close < swingHi
        if bosL
            hiBroken := true
            structure := 1
            if drawBOS
                line.new(math.max(swingHiAt,bar_index-9999), swingHi, bar_index, swingHi, color=color.lime)
        if bosS
            loBroken := true
            structure := -1
            if drawBOS
                line.new(math.max(swingLoAt,bar_index-9999), swingLo, bar_index, swingLo, color=color.red)
        int zi = array.size(zones)-1
        while zi >= 0
            Zone z = array.get(zones, zi)
            bool bullish = z.kind > 0
            bool isFVG = math.abs(z.kind) == 1
            bool expired = bar_index-z.born > (isFVG ? fvgLife : sdLife)
            bool invalid = isFVG ? (bullish ? low <= z.lo : high >= z.hi) : (bullish ? close < z.lo : close > z.hi)
            if expired or invalid
                if not na(z.visual)
                    box.delete(z.visual)
                array.remove(zones, zi)
            else
                bool touch = high >= z.lo and low <= z.hi
                bool reject = touch and not z.touched and (bullish ? close > z.hi : close < z.lo)
                fvgL := fvgL or (reject and z.kind == 1)
                fvgS := fvgS or (reject and z.kind == -1)
                sdL := sdL or (reject and z.kind == 2)
                sdS := sdS or (reject and z.kind == -2)
                if touch
                    z.touched := true
                if not na(z.visual)
                    box.set_right(z.visual, bar_index+1)
                    if z.touched
                        box.set_border_style(z.visual, line.style_dashed)
            zi -= 1
        // Creation follows evaluation: a zone cannot trigger on its formation/confirmation bar.
        if contiguous >= 3
            if low-high[2] >= syminfo.mintick
                f_add(high[2], low, 1)
            if low[2]-high >= syminfo.mintick
                f_add(high, low[2], -1)
        if contiguous >= leftBars+rightBars+1
            if not na(ph)
                swingHi := ph
                swingHiAt := bar_index
                hiBroken := false
                float lo = math.min(ph-syminfo.mintick, math.max(open[rightBars], close[rightBars]))
                f_add(lo, ph, -2)
            if not na(pl)
                swingLo := pl
                swingLoAt := bar_index
                loBroken := false
                float hi = math.max(pl+syminfo.mintick, math.min(open[rightBars], close[rightBars]))
                f_add(pl, hi, 2)

bool emaKnown = bar_index >= 49
bool momKnown = not na(rsi14[1])
float body = math.abs(close-open)
float span = high-low
bool rejectL = span > 0 and close > open and math.min(open,close)-low >= math.max(body,syminfo.mintick) and close >= low+span*2/3
bool rejectS = span > 0 and close < open and high-math.max(open,close) >= math.max(body,syminfo.mintick) and close <= low+span/3
float f1L = emaKnown ? (close > ema50 and ema21 > ema50 ? 1.0 : 0.0) : na
float f1S = emaKnown ? (close < ema50 and ema21 < ema50 ? 1.0 : 0.0) : na
float f2L = momKnown ? (rsi14 > 50 and rsi14 > rsi14[1] ? 1.0 : 0.0) : na
float f2S = momKnown ? (rsi14 < 50 and rsi14 < rsi14[1] ? 1.0 : 0.0) : na
float f3L = not na(rvol) ? (rvol >= rvolMin and close > open ? 1.0 : 0.0) : na
float f3S = not na(rvol) ? (rvol >= rvolMin and close < open ? 1.0 : 0.0) : na
float f4L = structure == 1 ? 1.0 : 0.0
float f4S = structure == -1 ? 1.0 : 0.0
float f5L = sweepL ? 1.0 : 0.0
float f5S = sweepS ? 1.0 : 0.0
float f6L = fvgL ? 1.0 : 0.0
float f6S = fvgS ? 1.0 : 0.0
float f7L = sdL ? 1.0 : 0.0
float f7S = sdS ? 1.0 : 0.0
float f8L = rejectL ? 1.0 : 0.0
float f8S = rejectS ? 1.0 : 0.0
float f9 = inSession ? 1.0 : 0.0
float f10L = htKnown ? (htClose > htEMA ? 1.0 : 0.0) : na
float f10S = htKnown ? (htClose < htEMA ? 1.0 : 0.0) : na
array<float> factorsL = array.from(f1L,f2L,f3L,f4L,f5L,f6L,f7L,f8L,f9,f10L,float(na))
array<float> factorsS = array.from(f1S,f2S,f3S,f4S,f5S,f6S,f7S,f8S,f9,f10S,float(na))
int scoreL = f_score(factorsL)
int scoreS = f_score(factorsS)
int maskL = f_mask(factorsL)
int maskS = f_mask(factorsS)
int known = math.min(f_known(factorsL), f_known(factorsS))
bool rawL = barstate.isconfirmed and (bosL or sweepL or fvgL or sdL)
bool rawS = barstate.isconfirmed and (bosS or sweepS or fvgS or sdS)
bool dataOK = not badOHLC and not badVolume and contiguous >= 50 and known == 10 and emaKnown and htKnown and not na(rvol) and not na(er) and (not requireMNQ or syminfo.root == "MNQ")
int regime = ema21 > ema50 ? 1 : ema21 < ema50 ? -1 : 0
bool chop = not na(er) and er < chopLimit
// Blocker bits: 1=data/warmup/instrument; 2=score; 4=CHOP; 8=session; 16=trend; 32=two directions.
int commonBlock = (dataOK ? 0 : 1)+(gateChop and chop ? 4 : 0)+(gateSession and not inSession ? 8 : 0)+(rawL and rawS ? 32 : 0)
int blockL = commonBlock+(scoreL < threshold ? 2 : 0)+(gateTrend and regime != 1 ? 16 : 0)
int blockS = commonBlock+(scoreS < threshold ? 2 : 0)+(gateTrend and regime != -1 ? 16 : 0)
bool approvedL = rawL and blockL == 0
bool approvedS = rawS and blockS == 0
int rawMask = (rawL ? 1 : 0)+(rawS ? 2 : 0)
int approvedMask = (approvedL ? 1 : 0)+(approvedS ? 2 : 0)
// Core bus for the separate native footprint pilot. Sentinel + two 2-bit masks + two 4-bit scores.
int bus = 100000+rawMask+4*approvedMask+16*scoreL+256*scoreS
string reasonL = (bosL ? "BOS " : "")+(sweepL ? "SWEEP " : "")+(fvgL ? "FVG " : "")+(sdL ? "DEMAND" : "")
string reasonS = (bosS ? "BOS " : "")+(sweepS ? "SWEEP " : "")+(fvgS ? "FVG " : "")+(sdS ? "SUPPLY" : "")
var array<string> recent = array.new_string()
if rawL or rawS
    string stamp = str.format_time(time, "yyyy-MM-dd HH:mm", "UTC")
    string msg = "{\"schema\":\"BR3.1\",\"symbol\":\""+syminfo.tickerid+"\",\"tf\":\""+timeframe.period+"\",\"bar_time\":"+str.tostring(time)+",\"bar_close\":"+str.tostring(time_close)+",\"observed_at\":"+str.tostring(timenow)+",\"realtime\":"+(barstate.isrealtime ? "true" : "false")+",\"raw\":"+str.tostring(rawMask)+",\"approved\":"+str.tostring(approvedMask)+",\"scoreL\":"+str.tostring(scoreL)+",\"scoreS\":"+str.tostring(scoreS)+",\"maskL\":"+str.tostring(maskL)+",\"maskS\":"+str.tostring(maskS)+",\"known\":"+str.tostring(known)+",\"blockL\":"+str.tostring(blockL)+",\"blockS\":"+str.tostring(blockS)+",\"rvol\":"+f_json(rvol)+",\"er\":"+f_json(er)+",\"whyL\":\""+reasonL+"\",\"whyS\":\""+reasonS+"\"}"
    msg := str.substring(msg,0,str.length(msg)-1)+",\"open\":"+f_json(open)+",\"high\":"+f_json(high)+",\"low\":"+f_json(low)+",\"close\":"+f_json(close)+",\"volume\":"+f_json(volume)+",\"ema21\":"+f_json(ema21)+",\"ema50\":"+f_json(ema50)+",\"rsi14\":"+f_json(rsi14)+",\"ht_close\":"+f_json(htClose)+",\"ht_ema\":"+f_json(htEMA)+",\"ht_closed_at\":"+f_json(htClosedAt)+",\"session\":"+(inSession ? "true" : "false")+",\"structure\":"+str.tostring(structure)+",\"contiguous\":"+str.tostring(contiguous)+"}"
    if showLabels and rawL
        label.new(bar_index, low, "LONG R"+(scoreL >= 7 ? "A" : "B")+" "+str.tostring(scoreL)+"/11\n"+(approvedL ? "READY*" : "GATED "+str.tostring(blockL)), style=label.style_label_up, color=approvedL ? color.lime : color.new(color.lime,65), textcolor=color.black, size=size.tiny, tooltip=msg)
    if showLabels and rawS
        label.new(bar_index, high, "SHORT R"+(scoreS >= 7 ? "A" : "B")+" "+str.tostring(scoreS)+"/11\n"+(approvedS ? "READY*" : "GATED "+str.tostring(blockS)), style=label.style_label_down, color=approvedS ? color.red : color.new(color.red,65), textcolor=color.white, size=size.tiny, tooltip=msg)
    array.unshift(recent, stamp+" "+(rawL ? "L "+str.tostring(scoreL)+" "+reasonL+" b="+str.tostring(blockL) : "")+(rawS ? " S "+str.tostring(scoreS)+" "+reasonS+" b="+str.tostring(blockS) : ""))
    if array.size(recent) > 6
        array.pop(recent)
    if pineLog
        log.info(msg)
    if liveAlerts and barstate.isrealtime
        alert(msg, alert.freq_once_per_bar_close)

plot(drawBOS ? swingHi : na, "Confirmed swing high", color=color.new(color.red,55), style=plot.style_linebr)
plot(drawBOS ? swingLo : na, "Confirmed swing low", color=color.new(color.lime,55), style=plot.style_linebr)
plotshape(drawSweep and sweepL, "Sweep low", shape.circle, location.belowbar, color.aqua, size=size.tiny)
plotshape(drawSweep and sweepS, "Sweep high", shape.circle, location.abovebar, color.fuchsia, size=size.tiny)
plot(barstate.isconfirmed ? bus : na, "BR3_BUS", display=display.data_window)
plot(barstate.isconfirmed ? scoreL : na, "BR3_score_L", display=display.data_window)
plot(barstate.isconfirmed ? scoreS : na, "BR3_score_S", display=display.data_window)
plot(rawMask, "BR3_raw_mask", display=display.data_window)
plot(approvedMask, "BR3_approved_mask", display=display.data_window)
plot(blockL, "BR3_block_L", display=display.data_window)
plot(blockS, "BR3_block_S", display=display.data_window)
plot(known, "BR3_known_of_11", display=display.data_window)
plot(maskL, "BR3_factor_mask_L", display=display.data_window)
plot(maskS, "BR3_factor_mask_S", display=display.data_window)
plot(rvol, "BR3_RVOL", display=display.data_window)
plot(er, "BR3_ER14", display=display.data_window)
plot(regime, "BR3_regime", display=display.data_window)
plot(inSession ? 1 : 0, "BR3_session", display=display.data_window)
plot(dataOK ? 1 : 0, "BR3_data_ok", display=display.data_window)
plot(gap ? 1 : 0, "BR3_gap_reset", display=display.data_window)
plot(htClosedAt, "BR3_HTF_closed_at_ms", display=display.data_window)
plot(htClose, "BR3_HTF_close", display=display.data_window)
plot(htEMA, "BR3_HTF_EMA50", display=display.data_window)
plot(ema21, "BR3_EMA21", display=display.data_window)
plot(ema50, "BR3_EMA50", display=display.data_window)
plot(rsi14, "BR3_RSI14", display=display.data_window)
plot(f1L, "F01_trend_L", display=display.data_window)
plot(f1S, "F01_trend_S", display=display.data_window)
plot(f2L, "F02_momentum_L", display=display.data_window)
plot(f2S, "F02_momentum_S", display=display.data_window)
plot(f3L, "F03_RVOL_L", display=display.data_window)
plot(f3S, "F03_RVOL_S", display=display.data_window)
plot(f4L, "F04_structure_L", display=display.data_window)
plot(f4S, "F04_structure_S", display=display.data_window)
plot(f5L, "F05_sweep_L", display=display.data_window)
plot(f5S, "F05_sweep_S", display=display.data_window)
plot(f6L, "F06_FVG_L", display=display.data_window)
plot(f6S, "F06_FVG_S", display=display.data_window)
plot(f7L, "F07_SD_L", display=display.data_window)
plot(f7S, "F07_SD_S", display=display.data_window)
plot(f8L, "F08_rejection_L", display=display.data_window)
plot(f8S, "F08_rejection_S", display=display.data_window)
plot(f9, "F09_session_both", display=display.data_window)
plot(f10L, "F10_HTF_L", display=display.data_window)
plot(f10S, "F10_HTF_S", display=display.data_window)
plot(float(na), "F11_UNKNOWN", display=display.data_window)

var table hud = table.new(position.top_right, 3, 18, bgcolor=color.new(color.black,15), border_width=1)
var table events = table.new(position.bottom_right, 1, 7, bgcolor=color.new(color.black,20))
var array<string> names = array.from("01 Trend","02 Momentum","03 RVOL","04 Structure","05 Sweep","06 FVG reject","07 S/D reject","08 Candle reject","09 Session","10 Closed HTF","11 Native FP")
if barstate.islast
    table.clear(hud,0,0,2,17)
    table.cell(hud,0,0,"BR3.1 | ASSUMPTIONS",text_color=color.yellow,text_size=size.small)
    table.cell(hud,1,0,"LONG",text_color=color.lime)
    table.cell(hud,2,0,"SHORT",text_color=color.red)
    table.cell(hud,0,1,"Score /11; known "+str.tostring(known),text_color=color.white)
    table.cell(hud,1,1,str.tostring(scoreL),text_color=color.white)
    table.cell(hud,2,1,str.tostring(scoreS),text_color=color.white)
    table.cell(hud,0,2,(regime == 1 ? "BULL" : regime == -1 ? "BEAR" : "NEUTRAL")+" | "+(chop ? "CHOP" : "TREND"),text_color=color.white)
    table.cell(hud,1,2,"VOL "+str.tostring(rvol,"#.##")+"x",text_color=color.white)
    table.cell(hud,2,2,inSession ? "SESSION" : "OFF",text_color=color.white)
    table.cell(hud,0,3,barstate.isconfirmed ? "CLOSED" : "PREVIEW; no signal",text_color=color.orange)
    table.cell(hud,1,3,blockL == 0 ? "READY*" : "GATED "+str.tostring(blockL),text_color=color.white)
    table.cell(hud,2,3,blockS == 0 ? "READY*" : "GATED "+str.tostring(blockS),text_color=color.white)
    if not compact
        for i = 0 to 10
            table.cell(hud,0,4+i,array.get(names,i),text_color=color.silver,text_size=size.small)
            table.cell(hud,1,4+i,f_text(array.get(factorsL,i)),text_color=color.white,text_size=size.small)
            table.cell(hud,2,4+i,f_text(array.get(factorsS,i)),text_color=color.white,text_size=size.small)
    table.cell(hud,0,15,"* Research permission only",text_color=color.orange,text_size=size.tiny)
    table.cell(hud,0,16,"F11 unknown; no normalization",text_color=color.orange,text_size=size.tiny)
    table.cell(hud,0,17,"No news / execution / risk layer",text_color=color.orange,text_size=size.tiny)
    table.clear(events,0,0,0,6)
    if showLog
        table.cell(events,0,0,"Raw events | UTC open | b=block bits",text_color=color.yellow,text_size=size.tiny)
        if array.size(recent) > 0
            for i = 0 to array.size(recent)-1
                table.cell(events,0,i+1,array.get(recent,i),text_color=color.white,text_size=size.tiny)
