//@version=6
strategy(
     "XAC v2.0-alpha2 — REBUILD IB",
     overlay = true,
     pyramiding = 0,
     process_orders_on_close = false,
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     initial_capital = 25000,
     margin_long = 0,
     margin_short = 0,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.50,
     slippage = 1
)

// ============================================================================
// XAC v2.0-alpha2 — CLEAN REBUILD / IB ONLY
//
// Stage 2 isolates legacy IB false-break semantics before any portfolio/router
// logic is introduced.
//
// Frozen IB source behavior:
// - Initial Balance = 00:00–00:59 Europe/Stockholm from 1m bars.
// - Evaluate completed 15m bars after IB is built.
// - False break HIGH: h15 > IBH and c15 < IBH.
// - False break LOW : l15 < IBL and c15 > IBL.
// - Freeze FIRST false break on each side regardless of volume.
// - Volume condition is applied AFTER first-side event selection.
// - Same-timestamp tie ordering: HIGH before LOW.
// - Only earliest qualifying IB trade/day.
// - RelVol = completed 15m volume / median of prior 20 completed 15m bars.
// - Minimum 10 prior observations.
// - Threshold = 1.75.
// - Entry submitted at completed 15m close; process_orders_on_close=false means
//   expected market fill at next 1m open.
// - Stop = signal 15m extreme +/- 1 tick.
// - Target = opposite IB edge.
// - Risk = $320, integer MNQ, max 20.
// ============================================================================

string TZ = "Europe/Stockholm"
float TICK = syminfo.mintick
float MNQ_POINT_VALUE = 2.0

string G0 = "00 — Rebuild"
bool USE_IB = input.bool(true, "IB enabled", group = G0)
bool SHOW_MARKS = input.bool(true, "Show explicit QA marks", group = G0)
bool SHOW_LEVELS = input.bool(true, "Show IB levels", group = G0)
bool SHOW_DASH = input.bool(true, "Show mobile dashboard", group = G0)

string G1 = "01 — IB frozen"
float IB_VOL_MIN = input.float(1.75, "IB volume ratio", step = 0.25, group = G1)
float RISK_IB_USD = input.float(320.0, "IB risk USD", step = 10, group = G1)
int MAX_MNQ = input.int(20, "Max MNQ", minval = 1, maxval = 20, group = G1)
int FLAT_HOUR_STHLM = input.int(22, "Flat hour Stockholm", minval = 0, maxval = 23, group = G1)

if barstate.isfirst
    if not chart.is_standard
        runtime.error("Use standard candles.")
    if not timeframe.isminutes or timeframe.multiplier != 1
        runtime.error("Use MNQ 1-minute chart.")

f_qty(float entryPx, float stopPx, float riskUsd) =>
    float riskPts = math.abs(entryPx - stopPx)
    float usdPerContract = riskPts * MNQ_POINT_VALUE
    int q = usdPerContract > 0 ? int(math.floor(riskUsd / usdPerContract)) : 0
    math.max(0, math.min(MAX_MNQ, q))

f_pf() =>
    float gl = math.abs(strategy.grossloss)
    gl > 0 ? strategy.grossprofit / gl : na

// ============================================================================
// DAILY IB STATE
// ============================================================================

bool isNewDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)

var float ibh = na
var float ibl = na
var bool ibBuilt = false
var bool ibHighSeen = false
var bool ibLowSeen = false
var bool ibTradeTaken = false

var int cDays = 0
var int cIBBuilt = 0
var int cHighRaw = 0
var int cLowRaw = 0
var int cHighFirst = 0
var int cLowFirst = 0
var int cVolPass = 0
var int cOrders = 0
var int cFills = 0
var int cClosed = 0

if barstate.isfirst
    cDays := 1

if isNewDay
    cDays += 1
    ibh := na
    ibl := na
    ibBuilt := false
    ibHighSeen := false
    ibLowSeen := false
    ibTradeTaken := false

// Exact 00:00–00:59 Stockholm Initial Balance.
if hour(time, TZ) == 0
    ibh := na(ibh) ? high : math.max(ibh, high)
    ibl := na(ibl) ? low : math.min(ibl, low)

// IB becomes available starting 01:00 Stockholm.
if hour(time, TZ) >= 1 and not ibBuilt and not na(ibh) and not na(ibl)
    ibBuilt := true
    cIBBuilt += 1

// ============================================================================
// 15m AGGREGATOR + PRIOR VOLUME HISTORY
// ============================================================================

var float o15 = na
var float h15 = na
var float l15 = na
var float c15 = na
var float v15 = 0.0
var array<float> vols15 = array.new_float()

bool start15 = minute(time, TZ) % 15 == 0
bool end15 = minute(time, TZ) % 15 == 14

if start15 or na(o15)
    o15 := open
    h15 := high
    l15 := low
    c15 := close
    v15 := volume
else
    h15 := math.max(h15, high)
    l15 := math.min(l15, low)
    c15 := close
    v15 += volume

// Per-bar QA event flags.
bool qaHighRaw = false
bool qaLowRaw = false
bool qaHighFirst = false
bool qaLowFirst = false
bool qaOrderShort = false
bool qaOrderLong = false

if end15
    // Median of PRIOR completed 15m bars. Current bar is appended only after scoring.
    float med20 = na
    int nv = array.size(vols15)

    if nv >= 10
        array<float> tmp = array.copy(vols15)
        array.sort(tmp)
        int nn = array.size(tmp)
        med20 := nn % 2 == 1 ? array.get(tmp, nn / 2) : (array.get(tmp, nn / 2 - 1) + array.get(tmp, nn / 2)) / 2.0

    float volRatio = not na(med20) and med20 > 0 ? v15 / med20 : na
    int sigHour = hour(time, TZ)

    if USE_IB and ibBuilt and sigHour >= 1 and sigHour < FLAT_HOUR_STHLM
        bool highFB = h15 > ibh and c15 < ibh
        bool lowFB = l15 < ibl and c15 > ibl

        if highFB
            cHighRaw += 1
            qaHighRaw := true

        if lowFB
            cLowRaw += 1
            qaLowRaw := true

        // Source ordering: HIGH side first on a same-timestamp tie.
        if highFB and not ibHighSeen
            ibHighSeen := true
            cHighFirst += 1
            qaHighFirst := true

            if not ibTradeTaken and not na(volRatio) and volRatio >= IB_VOL_MIN and strategy.position_size == 0
                cVolPass += 1
                float sl = h15 + TICK
                int qty = f_qty(close, sl, RISK_IB_USD)

                if qty > 0
                    strategy.entry("IB-S", strategy.short, qty = qty, comment = "IB")
                    strategy.exit("IB-S-X", "IB-S", stop = sl, limit = ibl)
                    ibTradeTaken := true
                    cOrders += 1
                    qaOrderShort := true

        if lowFB and not ibLowSeen
            ibLowSeen := true
            cLowFirst += 1
            qaLowFirst := true

            if not ibTradeTaken and not na(volRatio) and volRatio >= IB_VOL_MIN and strategy.position_size == 0
                cVolPass += 1
                float sl = l15 - TICK
                int qty = f_qty(close, sl, RISK_IB_USD)

                if qty > 0
                    strategy.entry("IB-L", strategy.long, qty = qty, comment = "IB")
                    strategy.exit("IB-L-X", "IB-L", stop = sl, limit = ibh)
                    ibTradeTaken := true
                    cOrders += 1
                    qaOrderLong := true

    array.push(vols15, v15)
    if array.size(vols15) > 20
        array.shift(vols15)

// ============================================================================
// FILL / CLOSE OBSERVABILITY
// ============================================================================

bool justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
bool justClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
bool fillLong = justOpened and strategy.position_size > 0
bool fillShort = justOpened and strategy.position_size < 0

if justOpened
    cFills += 1

if justClosed
    cClosed += 1

if hour(time, TZ) == FLAT_HOUR_STHLM and minute(time, TZ) == 0
    strategy.close_all(comment = "XAC FLAT")

// ============================================================================
// EXPLICIT MOBILE QA MARKS
// ============================================================================

plotshape(
     SHOW_MARKS and qaHighFirst,
     title = "IB HIGH FIRST",
     style = shape.triangledown,
     location = location.abovebar,
     text = "IB?",
     textcolor = color.white,
     color = color.new(color.red, 25),
     size = size.tiny
)

plotshape(
     SHOW_MARKS and qaLowFirst,
     title = "IB LOW FIRST",
     style = shape.triangleup,
     location = location.belowbar,
     text = "IB?",
     textcolor = color.white,
     color = color.new(color.green, 25),
     size = size.tiny
)

plotshape(
     SHOW_MARKS and qaOrderShort,
     title = "IB SHORT ORDER",
     style = shape.circle,
     location = location.abovebar,
     text = "O",
     textcolor = color.white,
     color = color.red,
     size = size.tiny
)

plotshape(
     SHOW_MARKS and qaOrderLong,
     title = "IB LONG ORDER",
     style = shape.circle,
     location = location.belowbar,
     text = "O",
     textcolor = color.white,
     color = color.green,
     size = size.tiny
)

plotshape(
     SHOW_MARKS and fillLong,
     title = "IB LONG FILL",
     style = shape.labelup,
     location = location.belowbar,
     text = "IB L",
     textcolor = color.white,
     color = color.green,
     size = size.small
)

plotshape(
     SHOW_MARKS and fillShort,
     title = "IB SHORT FILL",
     style = shape.labeldown,
     location = location.abovebar,
     text = "IB S",
     textcolor = color.white,
     color = color.red,
     size = size.small
)

plotshape(
     SHOW_MARKS and justClosed,
     title = "IB EXIT",
     style = shape.xcross,
     location = location.abovebar,
     text = "X",
     color = color.black,
     size = size.small
)

plot(SHOW_LEVELS and ibBuilt ? ibh : na, "IBH", color = color.new(color.blue, 20), style = plot.style_linebr)
plot(SHOW_LEVELS and ibBuilt ? ibl : na, "IBL", color = color.new(color.blue, 20), style = plot.style_linebr)

// ============================================================================
// MOBILE DASHBOARD
// ============================================================================

var table dash = table.new(position.top_right, 4, 11, border_width = 1)

if SHOW_DASH and barstate.islast
    color hdr = color.rgb(35, 35, 35)
    color bg1 = color.rgb(245, 245, 245)
    color bg2 = color.rgb(230, 230, 230)
    color txt = color.black
    color inv = color.white

    table.clear(dash, 0, 0, 3, 10)

    table.cell(dash, 0, 0, "XAC v2 α2", text_color = inv, bgcolor = hdr)
    table.cell(dash, 1, 0, "IB", text_color = inv, bgcolor = hdr)
    table.cell(dash, 2, 0, "Closed", text_color = inv, bgcolor = hdr)
    table.cell(dash, 3, 0, str.tostring(strategy.closedtrades), text_color = inv, bgcolor = hdr)

    table.cell(dash, 0, 1, "PF", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 1, str.tostring(f_pf(), "#.###"), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 1, "Pos", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 1, str.tostring(strategy.position_size), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 2, "Days", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 2, str.tostring(cDays), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 2, "IB built", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 2, str.tostring(cIBBuilt), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 3, "Raw H/L", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 3, str.tostring(cHighRaw)+"/"+str.tostring(cLowRaw), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 3, "First H/L", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 3, str.tostring(cHighFirst)+"/"+str.tostring(cLowFirst), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 4, "Vol pass", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 4, str.tostring(cVolPass), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 4, "Orders", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 4, str.tostring(cOrders), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 5, "Fills", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 5, str.tostring(cFills), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 5, "Closed QA", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 5, str.tostring(cClosed), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 6, "High seen", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 6, ibHighSeen ? "YES" : "NO", text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 6, "Low seen", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 6, ibLowSeen ? "YES" : "NO", text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 7, "Trade today", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 7, ibTradeTaken ? "YES" : "NO", text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 7, "Built", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 7, ibBuilt ? "YES" : "NO", text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 8, "IBH", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 8, str.tostring(ibh, "#.##"), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 8, "IBL", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 8, str.tostring(ibl, "#.##"), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 9, "Vol gate", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 9, str.tostring(IB_VOL_MIN, "#.##"), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 9, "Risk", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 9, "$"+str.tostring(RISK_IB_USD, "#"), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 10, "STATUS", text_color = inv, bgcolor = hdr)
    table.cell(dash, 1, 10, "REBUILD", text_color = inv, bgcolor = hdr)
    table.cell(dash, 2, 10, "Stage", text_color = inv, bgcolor = hdr)
    table.cell(dash, 3, 10, "IB ONLY", text_color = inv, bgcolor = hdr)
