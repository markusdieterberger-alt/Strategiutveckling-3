//@version=6
strategy(
     "XAC v2.0-alpha3 — REBUILD IBT",
     overlay = true,
     pyramiding = 0,
     process_orders_on_close = false,
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     initial_capital = 25000,
     margin_long = 0,
     margin_short = 0,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.50,
     slippage = 1
)

// ============================================================================
// XAC v2.0-alpha3 — CLEAN REBUILD / IBT ONLY
//
// Frozen IBT behavior reconstructed from preserved XAC source:
// - Initial Balance = 00:00–00:59 Europe/Stockholm.
// - Evaluate completed 15m bars from 01:00 until flat hour.
// - Extension = 0.25 * IB range.
// - High extension rejection:
//     h15 > IBH + 0.25*range
//     c15 < upper extension
//     c15 > IBH
// - Low extension rejection:
//     l15 < IBL - 0.25*range
//     c15 > lower extension
//     c15 < IBL
// - Freeze ONE EARLIEST IBT candidate/day BEFORE volume filter.
// - Volume ratio = completed 15m volume / median prior 20 completed 15m bars.
// - Minimum 10 prior observations.
// - Volume threshold = 1.25.
// - Entry submitted at completed 15m close; expected fill next 1m open.
// - Stop = signal 15m extreme +/- 1 tick.
// - Target = nearest IB edge (IBH for high rejection, IBL for low rejection).
// - Risk = $180, integer MNQ, max 20.
// ============================================================================

string TZ = "Europe/Stockholm"
float TICK = syminfo.mintick
float MNQ_POINT_VALUE = 2.0

string G0 = "00 — Rebuild"
bool USE_IBT = input.bool(true, "IBT enabled", group = G0)
bool SHOW_MARKS = input.bool(true, "Show explicit QA marks", group = G0)
bool SHOW_LEVELS = input.bool(true, "Show IB/extension levels", group = G0)
bool SHOW_DASH = input.bool(true, "Show mobile dashboard", group = G0)

string G1 = "01 — IBT frozen"
float IBT_K = input.float(0.25, "Extension x IB range", step = 0.25, group = G1)
float IBT_VOL_MIN = input.float(1.25, "IBT volume ratio", step = 0.25, group = G1)
float RISK_IBT_USD = input.float(180.0, "IBT risk USD", step = 10, group = G1)
int MAX_MNQ = input.int(20, "Max MNQ", minval = 1, maxval = 20, group = G1)
int FLAT_HOUR_STHLM = input.int(22, "Flat hour Stockholm", minval = 0, maxval = 23, group = G1)

if barstate.isfirst
    if not chart.is_standard
        runtime.error("Use standard candles.")
    if not timeframe.isminutes or timeframe.multiplier != 1
        runtime.error("Use MNQ 1-minute chart.")

f_qty(float entryPx, float stopPx, float riskUsd) =>
    float riskPts = math.abs(entryPx - stopPx)
    float usdPerContract = riskPts * MNQ_POINT_VALUE
    int q = usdPerContract > 0 ? int(math.floor(riskUsd / usdPerContract)) : 0
    math.max(0, math.min(MAX_MNQ, q))

f_pf() =>
    float gl = math.abs(strategy.grossloss)
    gl > 0 ? strategy.grossprofit / gl : na

bool isNewDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)

var float ibh = na
var float ibl = na
var bool ibBuilt = false
var bool ibtCandidateSeen = false

var int cDays = 0
var int cIBBuilt = 0
var int cRawHigh = 0
var int cRawLow = 0
var int cCandidate = 0
var int cCandidateHigh = 0
var int cCandidateLow = 0
var int cVolPass = 0
var int cQtyZero = 0
var int cBlockedPos = 0
var int cOrders = 0
var int cFills = 0
var int cClosed = 0

if barstate.isfirst
    cDays := 1

if isNewDay
    cDays += 1
    ibh := na
    ibl := na
    ibBuilt := false
    ibtCandidateSeen := false

if hour(time, TZ) == 0
    ibh := na(ibh) ? high : math.max(ibh, high)
    ibl := na(ibl) ? low : math.min(ibl, low)

if hour(time, TZ) >= 1 and not ibBuilt and not na(ibh) and not na(ibl)
    ibBuilt := true
    cIBBuilt += 1

var float o15 = na
var float h15 = na
var float l15 = na
var float c15 = na
var float v15 = 0.0
var array<float> vols15 = array.new_float()

bool start15 = minute(time, TZ) % 15 == 0
bool end15 = minute(time, TZ) % 15 == 14

if start15 or na(o15)
    o15 := open
    h15 := high
    l15 := low
    c15 := close
    v15 := volume
else
    h15 := math.max(h15, high)
    l15 := math.min(l15, low)
    c15 := close
    v15 += volume

bool qaCandidateHigh = false
bool qaCandidateLow = false
bool qaOrderShort = false
bool qaOrderLong = false

if end15
    float med20 = na
    int nv = array.size(vols15)

    if nv >= 10
        array<float> tmp = array.copy(vols15)
        array.sort(tmp)
        int nn = array.size(tmp)
        med20 := nn % 2 == 1 ? array.get(tmp, nn / 2) : (array.get(tmp, nn / 2 - 1) + array.get(tmp, nn / 2)) / 2.0

    float volRatio = not na(med20) and med20 > 0 ? v15 / med20 : na
    int sigHour = hour(time, TZ)

    if USE_IBT and ibBuilt and sigHour >= 1 and sigHour < FLAT_HOUR_STHLM
        float rg = ibh - ibl
        float up = ibh + IBT_K * rg
        float dn = ibl - IBT_K * rg

        bool extHigh = rg > 0 and h15 > up and c15 < up and c15 > ibh
        bool extLow  = rg > 0 and l15 < dn and c15 > dn and c15 < ibl

        if extHigh
            cRawHigh += 1
        if extLow
            cRawLow += 1

        // Exact source semantics: select one earliest candidate/day before volume filter.
        if not ibtCandidateSeen and (extHigh or extLow)
            ibtCandidateSeen := true
            cCandidate += 1

            bool chooseHigh = extHigh
            bool chooseLow = not extHigh and extLow

            if chooseHigh
                cCandidateHigh += 1
                qaCandidateHigh := true
            if chooseLow
                cCandidateLow += 1
                qaCandidateLow := true

            if not na(volRatio) and volRatio >= IBT_VOL_MIN
                cVolPass += 1

                if strategy.position_size == 0
                    if chooseHigh
                        float sl = h15 + TICK
                        int qty = f_qty(close, sl, RISK_IBT_USD)

                        if qty > 0
                            strategy.entry("IBT-S", strategy.short, qty = qty, comment = "IBT")
                            strategy.exit("IBT-S-X", "IBT-S", stop = sl, limit = ibh)
                            cOrders += 1
                            qaOrderShort := true
                        else
                            cQtyZero += 1

                    if chooseLow
                        float sl = l15 - TICK
                        int qty = f_qty(close, sl, RISK_IBT_USD)

                        if qty > 0
                            strategy.entry("IBT-L", strategy.long, qty = qty, comment = "IBT")
                            strategy.exit("IBT-L-X", "IBT-L", stop = sl, limit = ibl)
                            cOrders += 1
                            qaOrderLong := true
                        else
                            cQtyZero += 1
                else
                    cBlockedPos += 1

    array.push(vols15, v15)
    if array.size(vols15) > 20
        array.shift(vols15)

bool justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
bool justClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
bool fillLong = justOpened and strategy.position_size > 0
bool fillShort = justOpened and strategy.position_size < 0

if justOpened
    cFills += 1
if justClosed
    cClosed += 1

if hour(time, TZ) == FLAT_HOUR_STHLM and minute(time, TZ) == 0
    strategy.close_all(comment = "XAC FLAT")

plotshape(
     SHOW_MARKS and qaCandidateHigh,
     title = "IBT HIGH CANDIDATE",
     style = shape.triangledown,
     location = location.abovebar,
     text = "IBT?",
     textcolor = color.white,
     color = color.new(color.red, 25),
     size = size.tiny
)

plotshape(
     SHOW_MARKS and qaCandidateLow,
     title = "IBT LOW CANDIDATE",
     style = shape.triangleup,
     location = location.belowbar,
     text = "IBT?",
     textcolor = color.white,
     color = color.new(color.green, 25),
     size = size.tiny
)

plotshape(
     SHOW_MARKS and qaOrderShort,
     title = "IBT SHORT ORDER",
     style = shape.circle,
     location = location.abovebar,
     text = "O",
     textcolor = color.white,
     color = color.red,
     size = size.tiny
)

plotshape(
     SHOW_MARKS and qaOrderLong,
     title = "IBT LONG ORDER",
     style = shape.circle,
     location = location.belowbar,
     text = "O",
     textcolor = color.white,
     color = color.green,
     size = size.tiny
)

plotshape(
     SHOW_MARKS and fillLong,
     title = "IBT LONG FILL",
     style = shape.labelup,
     location = location.belowbar,
     text = "IBT L",
     textcolor = color.white,
     color = color.green,
     size = size.small
)

plotshape(
     SHOW_MARKS and fillShort,
     title = "IBT SHORT FILL",
     style = shape.labeldown,
     location = location.abovebar,
     text = "IBT S",
     textcolor = color.white,
     color = color.red,
     size = size.small
)

plotshape(
     SHOW_MARKS and justClosed,
     title = "IBT EXIT",
     style = shape.xcross,
     location = location.abovebar,
     text = "X",
     color = color.black,
     size = size.small
)

float ibRange = not na(ibh) and not na(ibl) ? ibh - ibl : na
float upperExt = not na(ibRange) ? ibh + IBT_K * ibRange : na
float lowerExt = not na(ibRange) ? ibl - IBT_K * ibRange : na

plot(SHOW_LEVELS and ibBuilt ? ibh : na, "IBH", color = color.new(color.blue, 20), style = plot.style_linebr)
plot(SHOW_LEVELS and ibBuilt ? ibl : na, "IBL", color = color.new(color.blue, 20), style = plot.style_linebr)
plot(SHOW_LEVELS and ibBuilt ? upperExt : na, "IBT upper", color = color.new(color.red, 55), style = plot.style_linebr)
plot(SHOW_LEVELS and ibBuilt ? lowerExt : na, "IBT lower", color = color.new(color.green, 55), style = plot.style_linebr)

var table dash = table.new(position.top_right, 4, 12, border_width = 1)

if SHOW_DASH and barstate.islast
    color hdr = color.rgb(35, 35, 35)
    color bg1 = color.rgb(245, 245, 245)
    color bg2 = color.rgb(230, 230, 230)
    color txt = color.black
    color inv = color.white

    table.clear(dash, 0, 0, 3, 11)

    table.cell(dash, 0, 0, "XAC v2 α3", text_color = inv, bgcolor = hdr)
    table.cell(dash, 1, 0, "IBT", text_color = inv, bgcolor = hdr)
    table.cell(dash, 2, 0, "Closed", text_color = inv, bgcolor = hdr)
    table.cell(dash, 3, 0, str.tostring(strategy.closedtrades), text_color = inv, bgcolor = hdr)

    table.cell(dash, 0, 1, "PF", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 1, str.tostring(f_pf(), "#.###"), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 1, "Pos", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 1, str.tostring(strategy.position_size), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 2, "Days", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 2, str.tostring(cDays), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 2, "IB built", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 2, str.tostring(cIBBuilt), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 3, "Raw ext H/L", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 3, str.tostring(cRawHigh)+"/"+str.tostring(cRawLow), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 3, "Candidates", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 3, str.tostring(cCandidate), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 4, "Cand H/L", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 4, str.tostring(cCandidateHigh)+"/"+str.tostring(cCandidateLow), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 4, "Vol pass", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 4, str.tostring(cVolPass), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 5, "Orders", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 5, str.tostring(cOrders), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 5, "Fills", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 5, str.tostring(cFills), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 6, "Closed QA", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 6, str.tostring(cClosed), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 6, "Qty0", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 6, str.tostring(cQtyZero), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 7, "Blocked pos", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 7, str.tostring(cBlockedPos), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 7, "Seen today", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 7, ibtCandidateSeen ? "YES" : "NO", text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 8, "IBH", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 8, str.tostring(ibh, "#.##"), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 8, "IBL", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 8, str.tostring(ibl, "#.##"), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 9, "Ext K", text_color = txt, bgcolor = bg1)
    table.cell(dash, 1, 9, str.tostring(IBT_K, "#.##"), text_color = txt, bgcolor = bg1)
    table.cell(dash, 2, 9, "Vol gate", text_color = txt, bgcolor = bg1)
    table.cell(dash, 3, 9, str.tostring(IBT_VOL_MIN, "#.##"), text_color = txt, bgcolor = bg1)

    table.cell(dash, 0, 10, "Risk", text_color = txt, bgcolor = bg2)
    table.cell(dash, 1, 10, "$"+str.tostring(RISK_IBT_USD, "#"), text_color = txt, bgcolor = bg2)
    table.cell(dash, 2, 10, "Max MNQ", text_color = txt, bgcolor = bg2)
    table.cell(dash, 3, 10, str.tostring(MAX_MNQ), text_color = txt, bgcolor = bg2)

    table.cell(dash, 0, 11, "STATUS", text_color = inv, bgcolor = hdr)
    table.cell(dash, 1, 11, "REBUILD", text_color = inv, bgcolor = hdr)
    table.cell(dash, 2, 11, "Stage", text_color = inv, bgcolor = hdr)
    table.cell(dash, 3, 11, "IBT ONLY", text_color = inv, bgcolor = hdr)
