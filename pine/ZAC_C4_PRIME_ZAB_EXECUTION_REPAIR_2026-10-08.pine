//@version=6
// REPAIR 2026-10-08: PRIME market-order submission aligned to signal bar.
// UNVERIFIED: TradingView compilation, fills, and canonical Python quantity parity.
// This script was generated by PineScripter.app
// DISCLAIMER: This code is for educational and testing purposes only.
// PineScripter is a coding tool, not a financial advisor.
// Past performance in backtests does not guarantee future results.
// Always verify code logic and test on a demo account before use.
// =====================================================================
// ZAC PORTFOLIO (C4 / PRIME / ZAB) — Python-parity translation
// =====================================================================
// Translator notes:
//  - Three independent modules share one portfolio position slot.
//  - All higher-timeframe values are read causally. The completed-bar
//    causality marker is the HTF open-time change. The completed-bar
//    state itself is read from `high[1]/low[1]/close[1]/volume[1]` of
//    each HTF request — never the forming bar.
//  - Volume Profile is built from raw 1-minute bars and frozen at the
//    module-specific cadence (5 minutes for C4, 180 minutes for ZAB).
//    All associated balance metrics (compression, efficiency, close-in-
//    VA) are computed once and frozen alongside POC/VAH/VAL.
//  - FVG lifecycle is CREATE -> ACTIVE/UNTOUCHED -> TOUCHED/PRUNED.
//    Rising edges are detected on the previous-bar state so a new
//    FVG is never destroyed by the same 1m bar that made it known.
//  - Order/brackets go through strategy.entry/exit so strategy.closedtrades
//    can be inspected for module identity and accounting parity checks.
//  - Prime (D00055) is implemented from the spec-defined rules. The
//    single genuinely underspecified piece — the exact buffered-VA
//    construction used by the original AMT Core — is isolated inside
//    a `PRIME_CANONICAL_DETAIL_REQUIRED` block; a diagnostic counter
//    (`nPrimeUnresolvedCanonical`) exposes it.
//  - No commissions in this ZAC parity version. Prime's documented
//    1.0-index-point adverse friction is part of the SOURCE reference
//    and is kept out of this TradingView emulation.
// =====================================================================
strategy("ZAC Portfolio (C4/PRIME/ZAB) v2",
     overlay=true,
     pyramiding=0,
     calc_on_order_fills=false,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     fill_orders_on_standard_ohlc=false,
     max_bars_back=5000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     initial_capital=25000,
     currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.0,
     max_lines_count=500,
     max_labels_count=500)

// =====================================================================
// CONSTANTS — MNQ
// =====================================================================
MNQ_TICK       = 0.25
MNQ_POINT      = 2.0
MAX_CONTRACTS  = 20

// =====================================================================
// INPUTS
// =====================================================================
gMode = "MODE"
useFunded = input.bool(false, "Enable FUNDED-mode rules", group=gMode)

gEn = "MODULE ENABLE"
enableC4    = input.bool(true,  "Enable C4",    group=gEn)
enablePrime = input.bool(true,  "Enable Prime", group=gEn)
enableZAB   = input.bool(true,  "Enable ZAB",   group=gEn)

gC4 = "C4 (D00054)"
i_c4Risk        = input.float(350.0, "Risk $/trade",        group=gC4)
i_c4VPBars      = input.int  (180,   "VP bars (1m)",        group=gC4)
i_c4Bins        = input.int  (60,    "Bins",                group=gC4)
i_c4VA          = input.float(0.70,  "Value Area %",        group=gC4)
i_c4FreezeMins  = input.int  (5,     "Freeze (min)",        group=gC4)
i_c4MaxEff      = input.float(0.35,  "Max efficiency",      group=gC4)
i_c4MinCloseVA  = input.float(0.65,  "Min close-in-VA",     group=gC4)
i_c4MaxCompATR  = input.float(1.0,   "Max VA comp (×ATR)",  group=gC4)
i_c4MinDispATR  = input.float(0.10,  "Min disp (×ATR)",     group=gC4)
i_c4RelVolMin   = input.float(1.0,   "RelVol5 ≥",           group=gC4)
i_c4MaxPending  = input.int  (10,    "Pending max (min)",   group=gC4)
i_c4MaxFGVDist  = input.float(8.0,   "FVG max dist (×ATR)", group=gC4)
i_c4StructMin   = input.float(0.25,  "Struct risk min (×ATR)", group=gC4)
i_c4MaxHold     = input.int  (120,   "Max hold (min)",      group=gC4)

gPrime = "PRIME (D00055) — canonical-detail markers in code"
i_primeRisk       = input.float(500.0, "Risk $/trade",     group=gPrime)
i_primeMaxTarget  = input.float(1.0,   "Target ≤ (×VA w)",group=gPrime)
i_primeMaxHold    = input.int  (240,   "Max hold (min)",   group=gPrime)

gZAB = "ZAB-02A (D00064)"
i_zabRisk        = input.float(250.0, "Risk $/trade",        group=gZAB)
i_zabVPBars      = input.int  (180,   "VP bars (1m)",        group=gZAB)
i_zabBins        = input.int  (60,    "Bins",                group=gZAB)
i_zabVA          = input.float(0.70,  "Value Area %",        group=gZAB)
i_zabFreezeMins  = input.int  (180,   "Freeze (min)",        group=gZAB)
i_zabMinRelVol   = input.float(2.5,   "RelVol15 ≥",          group=gZAB)
i_zabRetestBars  = input.int  (10,    "Retest window (min)", group=gZAB)
i_zabStructMin   = input.float(0.25,  "Struct risk min (×ATR)", group=gZAB)
i_zabCooldown    = input.int  (30,    "Cooldown (min)",      group=gZAB)
i_zabMaxHold     = input.int  (120,   "Max hold (min)",      group=gZAB)

gDiag = "DIAGNOSTICS"
showDash   = input.bool(true,  "Show dashboard", group=gDiag)
showVPFill = input.bool(false, "Plot frozen VP edges", group=gDiag)

// =====================================================================
// TIMEZONE / SESSION HELPERS
// =====================================================================
chTz = "America/Chicago"
nyTz = "America/New_York"

inC4Session    = not na(time(timeframe.period, "0700-1429", chTz))
inPrimeSession = not na(time(timeframe.period, "0900-1059", nyTz))
inZABSession   = true

eodBar = not na(time(timeframe.period, "1559-1600", nyTz))
primeForceFlatBar = not na(time(timeframe.period, "1644-1645", nyTz))

// =====================================================================
// SHARED — ATR (1m, 14)
// =====================================================================
atr14 = ta.atr(14)

// =====================================================================
// FORWARD-DECLARED MODULE SIDES (used by the global portfolio router
// and per-module CanCreateNew gates). Each module re-declares its own
// side at its state-machine block; this declaration simply makes the
// name visible to anything that evaluates before those blocks.
// =====================================================================
var int _c4SideFD    = 0
var int _primeSideFD = 0
var int _zabSideFD   = 0

// =====================================================================
// FUNDED-MODE STATE (declared before modules so gates can reference it)
// =====================================================================
var float dailyPnl  = 0.0
var float cumPnl    = 0.0
var float bestDayPnl = 0.0
var float trailingFloor   = 24000.0
var float peakEODEquity  = 25000.0
var int   fundedLastTradeCount = 0
var bool  fundedBlockNewEntries = false

// =====================================================================
// DIAGNOSTIC COUNTERS (declared up front so per-module state machines
// can increment them at the moment the event happens)
// =====================================================================
var int nC4ProfileFreeze   = 0
var int nC4Balanced        = 0
var int nC4Rejection       = 0
var int nC4Displacement    = 0
var int nC4FVG             = 0
var int nC4RV              = 0
var int nC4StructOK        = 0
var int nC4Orders          = 0
var int nC4Fills           = 0
var int nC4Invalidations   = 0
var int nC4Expirations     = 0
var int nC4Closed          = 0
var int nPrimeBalances     = 0
var int nPrimeAccepts      = 0
var int nPrimePOCmigrate   = 0
var int nPrimeFVG          = 0
var int nPrimeTgtOK        = 0
var int nPrimeOrders       = 0
var int nPrimeFills        = 0
var int nPrimeClosed       = 0
var int nPrimeUnresolvedBlk= 0
var int nZabPOCcross       = 0
var int nZabCDpass         = 0
var int nZabCDblock        = 0
var int nZabRVpass         = 0
var int nZabOrders         = 0
var int nZabFills          = 0
var int nZabInvalidations  = 0
var int nZabExpirations    = 0
var int nZabClosed         = 0
var int nPortfolioPending  = 0
var int nPortfolioQtyZero  = 0
var int nFundedBlocks      = 0
var int nSimultaneousConflicts = 0
var int nLastCT            = 0
var int nLastModule        = 0   // 1=C4, 2=PRIME, 3=ZAB
var int portfolioOwner     = 0   // mirrors the last owner, for diagnostics
var int portfolioStateCode = 0   // 0=IDLE, 1=PENDING, 2=OPEN

startingAcct    = 25000.0
profitTarget    = startingAcct + 1250.0
maxDailyLoss    = -600.0
maxDayProfit    = 550.0

// =====================================================================
// TICK HELPERS
// =====================================================================
tickUp(p)   => math.round_to_mintick(p + MNQ_TICK)
tickDown(p) => math.round_to_mintick(p - MNQ_TICK)

// =====================================================================
// HTF CANDLE-COMPLETION MARKERS
//   A new 5m/15m/1H/3H/4H candle opens whenever the HTF `time` value
//   changes between consecutive 1m bars. The HTF state for the new
//   1m bar is the *just-completed* prior HTF candle, read from
//   `high[1]/low[1]/close[1]/volume[1]` of the HTF request — never
//   the still-forming bar.
// =====================================================================
htf5_t   = request.security(syminfo.tickerid, "5",   time)
htf15_t  = request.security(syminfo.tickerid, "15",  time)
htf60_t  = request.security(syminfo.tickerid, "60",  time)
htf180_t = request.security(syminfo.tickerid, "180", time)
htf240_t = request.security(syminfo.tickerid, "240", time)
htf3_t   = request.security(syminfo.tickerid, "3",   time)

new5mCandle   = not barstate.isfirst and htf5_t   != htf5_t[1]
new15mCandle  = not barstate.isfirst and htf15_t  != htf15_t[1]
new60mCandle  = not barstate.isfirst and htf60_t  != htf60_t[1]
new180mCandle = not barstate.isfirst and htf180_t != htf180_t[1]
new240mCandle = not barstate.isfirst and htf240_t != htf240_t[1]
new3mCandle   = not barstate.isfirst and htf3_t   != htf3_t[1]

// =====================================================================
// VOLUME PROFILE BUILDER (raw 1m bars)
//   Returns: [poc, vah, val, totalVol, volInVA, rangeHigh, rangeLow]
// =====================================================================
buildVP(int lb, int nBins, float vaPct) =>
    hiArr  = array.new_float(lb, 0.0)
    loArr  = array.new_float(lb, 0.0)
    volArr = array.new_float(lb, 0.0)
    for i = 0 to lb - 1
        array.set(hiArr,  i, high[i + 1])
        array.set(loArr,  i, low[i + 1])
        array.set(volArr, i, volume[i + 1])

    rangeH = array.max(hiArr)
    rangeL = array.min(loArr)
    rng    = rangeH - rangeL

    binV = array.new_float(nBins, 0.0)
    if rng > 0 and nBins > 0
        bsz = rng / nBins
        for i = 0 to lb - 1
            hh = array.get(hiArr,  i)
            ll = array.get(loArr,  i)
            vv = array.get(volArr, i)
            if hh > ll
                fB = math.floor((ll - rangeL) / bsz)
                lB = math.floor((hh - rangeL) / bsz)
                fB := math.max(0, math.min(nBins - 1, fB))
                lB := math.max(0, math.min(nBins - 1, lB))
                if lB >= fB
                    nT  = lB - fB + 1
                    vpb = vv / nT
                    for b = fB to lB
                        array.set(binV, b, array.get(binV, b) + vpb)

    totalV = array.sum(binV)
    maxV   = array.max(binV)

    pocIdx = 0
    for b = 0 to nBins - 1
        if array.get(binV, b) == maxV
            pocIdx := b
            break

    bsz2 = rng > 0 and nBins > 0 ? rng / nBins : 0.0
    pocPrice = rangeL + (pocIdx + 0.5) * bsz2

    volIn = array.get(binV, pocIdx)
    lIdx  = pocIdx
    rIdx  = pocIdx
    for _i = 0 to nBins
        if volIn >= totalV * vaPct
            break
        canL = lIdx > 0
        canR = rIdx < nBins - 1
        if not canL and not canR
            break
        vL = canL ? array.get(binV, lIdx - 1) : 0.0
        vR = canR ? array.get(binV, rIdx + 1) : 0.0
        if canR and (not canL or vR > vL)
            rIdx += 1
            volIn += array.get(binV, rIdx)
        else if canL
            lIdx -= 1
            volIn += array.get(binV, lIdx)

    vahPrice = rangeL + (rIdx + 1) * bsz2
    valPrice = rangeL + lIdx * bsz2

    [pocPrice, vahPrice, valPrice, totalV, volIn, rangeH, rangeL]

// =====================================================================
// FVG LIFECYCLE
//   Formation: 3-bar imbalance on the HTF, evaluated on the prior
//   completed HTF candle. Reads are from `high[1]/low[1]` so we never
//   touch the still-forming candle.
//   Creation: rising-edge detection on PREVIOUS-bar state (so the
//   creating bar is not the same 1m bar that prunes the new FVG).
//   Prune:    previous-bar overlap, explicit size>0 guard for empty
//   arrays.
// =====================================================================
htf60_h0  = request.security(syminfo.tickerid, "60",  high[1],  lookahead=barmerge.lookahead_off)
htf60_l0  = request.security(syminfo.tickerid, "60",  low[1],   lookahead=barmerge.lookahead_off)
htf60_h2  = request.security(syminfo.tickerid, "60",  high[2],  lookahead=barmerge.lookahead_off)
htf60_l2  = request.security(syminfo.tickerid, "60",  low[2],   lookahead=barmerge.lookahead_off)

htf240_h0 = request.security(syminfo.tickerid, "240", high[1],  lookahead=barmerge.lookahead_off)
htf240_l0 = request.security(syminfo.tickerid, "240", low[1],   lookahead=barmerge.lookahead_off)
htf240_h2 = request.security(syminfo.tickerid, "240", high[2],  lookahead=barmerge.lookahead_off)
htf240_l2 = request.security(syminfo.tickerid, "240", low[2],   lookahead=barmerge.lookahead_off)

htf15_h0  = request.security(syminfo.tickerid, "15",  high[1],  lookahead=barmerge.lookahead_off)
htf15_l0  = request.security(syminfo.tickerid, "15",  low[1],   lookahead=barmerge.lookahead_off)
htf15_h2  = request.security(syminfo.tickerid, "15",  high[2],  lookahead=barmerge.lookahead_off)
htf15_l2  = request.security(syminfo.tickerid, "15",  low[2],   lookahead=barmerge.lookahead_off)

fvg60Bull  = htf60_l0  > htf60_h2
fvg60Bear  = htf60_h0  < htf60_l2
fvg240Bull = htf240_l0 > htf240_h2
fvg240Bear = htf240_h0 < htf240_l2
fvg15Bull  = htf15_l0  > htf15_h2
fvg15Bear  = htf15_h0  < htf15_l2

new60Bull  = new60mCandle and fvg60Bull
new60Bear  = new60mCandle and fvg60Bear
new240Bull = new240mCandle and fvg240Bull
new240Bear = new240mCandle and fvg240Bear
new15Bull  = new15mCandle and fvg15Bull
new15Bear  = new15mCandle and fvg15Bear

var fvg60T  = array.new_float(0), var fvg60B  = array.new_float(0), var fvg60D  = array.new_int(0)
var fvg240T = array.new_float(0), var fvg240B = array.new_float(0), var fvg240D = array.new_int(0)
var fvg15T  = array.new_float(0), var fvg15B  = array.new_float(0), var fvg15D = array.new_int(0)

if new60Bull
    array.push(fvg60T, htf60_l0)
    array.push(fvg60B, htf60_h2)
    array.push(fvg60D,  1)
if new60Bear
    array.push(fvg60T, htf60_l2)
    array.push(fvg60B, htf60_h0)
    array.push(fvg60D, -1)
if new240Bull
    array.push(fvg240T, htf240_l0)
    array.push(fvg240B, htf240_h2)
    array.push(fvg240D,  1)
if new240Bear
    array.push(fvg240T, htf240_l2)
    array.push(fvg240B, htf240_h0)
    array.push(fvg240D, -1)
if new15Bull
    array.push(fvg15T, htf15_l0)
    array.push(fvg15B, htf15_h2)
    array.push(fvg15D,  1)
if new15Bear
    array.push(fvg15T, htf15_l2)
    array.push(fvg15B, htf15_h0)
    array.push(fvg15D, -1)

// Prune using the PREVIOUS 1m bar's overlap so a zone just created in
// this same execution is never destroyed. Empty-array safe.
fvgPrune(arrT, arrB, arrD) =>
    n = array.size(arrT)
    if n > 0
        for i = n - 1 to 0
            t = array.get(arrT, i)
            b = array.get(arrB, i)
            if high[1] >= b and low[1] <= t
                array.remove(arrT, i)
                array.remove(arrB, i)
                array.remove(arrD, i)

fvgPrune(fvg60T,  fvg60B,  fvg60D)
fvgPrune(fvg240T, fvg240B, fvg240D)
fvgPrune(fvg15T,  fvg15B,  fvg15D)

fvgNearestAhead(arrT, arrB, arrD, int dir, float refPrice, float maxDist) =>
    bestIdx  = -1
    bestDist = 1.0e20
    n = array.size(arrT)
    if n > 0
        for i = 0 to n - 1
            t = array.get(arrT, i)
            b = array.get(arrB, i)
            if dir == 1 and b >= refPrice
                d = b - refPrice
                if d <= maxDist and d < bestDist
                    bestIdx  := i
                    bestDist := d
            else if dir == -1 and t <= refPrice
                d = refPrice - t
                if d <= maxDist and d < bestDist
                    bestIdx  := i
                    bestDist := d
    [bestIdx, bestDist]

// Combined 1H+4H search for C4 — returns [src, idx, dist, top, bot]
fvgNearestCombined(int dir, float refPrice, float maxDist) =>
    [i1, d1] = fvgNearestAhead(fvg60T,  fvg60B,  fvg60D,  dir, refPrice, maxDist)
    [i4, d4] = fvgNearestAhead(fvg240T, fvg240B, fvg240D, dir, refPrice, maxDist)
    if d1 <= d4
        if i1 >= 0
            [1, i1, d1, array.get(fvg60T, i1), array.get(fvg60B, i1)]
        else
            [1, -1, 1e20, na, na]
    else
        if i4 >= 0
            [4, i4, d4, array.get(fvg240T, i4), array.get(fvg240B, i4)]
        else
            [4, -1, 1e20, na, na]

// =====================================================================
// RELVOL — completed-numerator only, current bar excluded from denom.
//   Numerator = volume[1] of the HTF (last completed HTF bar).
//   Denominator = mean of the PRIOR 20 completed HTF bars, i.e. the
//   20 HTF bars that closed strictly before the numerator. Built
//   explicitly so the numerator is never included.
// =====================================================================
htf5_vol_completed  = request.security(syminfo.tickerid, "5",  volume[1], lookahead=barmerge.lookahead_off)
htf15_vol_completed = request.security(syminfo.tickerid, "15", volume[1], lookahead=barmerge.lookahead_off)

htf5_vol_sum21  = request.security(syminfo.tickerid, "5",  math.sum(volume[1], 21), lookahead=barmerge.lookahead_off)
htf15_vol_sum21 = request.security(syminfo.tickerid, "15", math.sum(volume[1], 21), lookahead=barmerge.lookahead_off)

// Prior-20 mean = (sum of 21 prior completed bars - numerator) / 20
htf5_vol_avg20  = (htf5_vol_sum21  - htf5_vol_completed)  / 20.0
htf15_vol_avg20 = (htf15_vol_sum21 - htf15_vol_completed) / 20.0

relvol5  = htf5_vol_avg20  > 0 ? htf5_vol_completed  / htf5_vol_avg20  : 0.0
relvol15 = htf15_vol_avg20 > 0 ? htf15_vol_completed / htf15_vol_avg20 : 0.0

// =====================================================================
// C4 — Frozen Volume Profile (5m cadence)
//   At each 5m completion, freeze POC/VAH/VAL AND the balance metrics
//   together. Until the next 5m completion, every consumer reads the
//   frozen values — never a moving 180-bar window.
// =====================================================================
var float c4POC   = na
var float c4VAH   = na
var float c4VAL   = na
var float c4Compression_f = na
var float c4Efficiency_f  = na
var float c4CloseInVAF_f  = na
var int   c4FreezeBar = na

c4NeedBars = math.max(i_c4VPBars, 60)

if enableC4 and new5mCandle
    [p, hh, ll, tV, vaV, rH, rL] = buildVP(c4NeedBars, i_c4Bins, i_c4VA)
    c4POC   := p
    c4VAH   := hh
    c4VAL   := ll
    c4FreezeBar := bar_index
    // Compression = profileSpan / (avgTR * sqrt(180) + eps)
    profileSpan = rH - rL
    trSum = 0.0
    for i = 1 to c4NeedBars
        trSum += math.max(high[i] - low[i], math.abs(high[i] - close[i + 1]), math.abs(low[i] - close[i + 1]))
    avgTR = trSum / c4NeedBars
    c4Compression_f := profileSpan / (avgTR * math.sqrt(c4NeedBars) + 1e-9)
    // Efficiency = |close[1] - open[180]| / (profileSpan + eps)
    c4Efficiency_f  := math.abs(close[1] - open[c4NeedBars]) / (profileSpan + 1e-9)
    // Close-in-VA fraction
    inVACnt = 0
    for i = 1 to c4NeedBars
        c = close[i]
        if not na(c) and c >= ll and c <= hh
            inVACnt += 1
    c4CloseInVAF_f := c4NeedBars > 0 ? inVACnt / c4NeedBars : 0.0

c4Balanced = enableC4 and not na(c4Compression_f) and
             c4Compression_f <= i_c4MaxCompATR and
             c4Efficiency_f  <= i_c4MaxEff and
             c4CloseInVAF_f  >= i_c4MinCloseVA

// Rejection (separate from displacement). Rejection only checks that
// price touched through the frozen VA edge and closed back inside with
// a directional close. Displacement adds the ATR distance requirement.
c4LongReject  = enableC4 and inC4Session and c4Balanced and not na(c4VAL) and low <= c4VAL and close > c4VAL and close > open
c4ShortReject = enableC4 and inC4Session and c4Balanced and not na(c4VAH) and high >= c4VAH and close < c4VAH and close < open

// Displacement: close must be at least 0.10*ATR beyond the frozen VA edge
c4LongDisp  = c4LongReject  and (close - c4VAL) >= i_c4MinDispATR * atr14
c4ShortDisp = c4ShortReject and (c4VAH - close) >= i_c4MinDispATR * atr14

// Combined raw signal: rejection + displacement
c4LongRaw  = c4LongDisp
c4ShortRaw = c4ShortDisp

[longSrc1, longIdx1, longDist1, longTop1, longBot1] = fvgNearestCombined( 1, c4VAL, i_c4MaxFGVDist * atr14)
[longSrc2, longIdx2, longDist2, longTop2, longBot2] = fvgNearestCombined(-1, c4VAH, i_c4MaxFGVDist * atr14)

var float c4LongDist  = 1e20
var float c4ShortDist = 1e20
if c4LongRaw
    c4LongDist  := longDist1
else
    c4LongDist  := 1e20
if c4ShortRaw
    c4ShortDist := longDist2
else
    c4ShortDist := 1e20

c4LongRiskPerUnit  = (c4VAL - low) + MNQ_TICK
c4ShortRiskPerUnit = (high  - c4VAH) + MNQ_TICK
c4Long2RTarget  = c4VAL + 2.0 * c4LongRiskPerUnit
c4Short2RTarget = c4VAH - 2.0 * c4ShortRiskPerUnit
c4LongFVG2Rok  = c4LongRaw  and longIdx1 >= 0 and longTop1 > c4Long2RTarget
c4ShortFVG2Rok = c4ShortRaw and longIdx2 >= 0 and longBot2 < c4Short2RTarget

c4LongValidFVG  = c4LongRaw  and c4LongDist  <= i_c4MaxFGVDist * atr14 and c4LongFVG2Rok
c4ShortValidFVG = c4ShortRaw and c4ShortDist <= i_c4MaxFGVDist * atr14 and c4ShortFVG2Rok

c4LongRV  = c4LongValidFVG  and not na(relvol5) and relvol5 >= i_c4RelVolMin
c4ShortRV = c4ShortValidFVG and not na(relvol5) and relvol5 >= i_c4RelVolMin

c4LongStruct  = (c4VAL - low) + MNQ_TICK
c4ShortStruct = (high  - c4VAH) + MNQ_TICK
c4LongStructOK  = c4LongRaw  and c4LongStruct  >= i_c4StructMin * atr14
c4ShortStructOK = c4ShortRaw and c4ShortStruct >= i_c4StructMin * atr14

// =====================================================================
// FUNDED GATE — single switch, applied to all three modules below
// =====================================================================
passFundedAll = not useFunded or not fundedBlockNewEntries

// =====================================================================
// C4 — final readiness (used both for placement and for diagnostics)
// =====================================================================
c4LongReady  = c4LongRV  and c4LongStructOK  and strategy.position_size == 0 and strategy.opentrades == 0 and passFundedAll
c4ShortReady = c4ShortRV and c4ShortStructOK and strategy.position_size == 0 and strategy.opentrades == 0 and passFundedAll

// =====================================================================
// C4 — ORDER MANAGEMENT — explicit lifecycle: IDLE -> PENDING -> OPEN
//   A resting limit order has position_size==0 / opentrades==0 until
//   it fills. FLAT != IDLE while pending. The state machine is
//   therefore driven off c4Side, NOT off strategy.position_size alone.
// =====================================================================
var int   c4SignalBar  = na
var int   c4FillBar    = na
var int   c4Side       = 0
var int   c4Qty        = 0
var float c4Entry      = na
var float c4Stop       = na
var float c4Target     = na
var float c4RiskAmt    = 0.0

c4IsOpen      = (c4Side != 0 and strategy.position_size != 0)
c4HasPending  = (c4Side != 0 and strategy.position_size == 0 and strategy.opentrades == 0)
// Global portfolio slot is considered free when no module had a side on
// the previous bar. This enforces a 1-bar separation between
// simultaneous C4 + Prime + ZAB ready events (router priority).
c4CanCreateNew = (c4Side == 0 and _c4SideFD == 0 and _primeSideFD == 0 and _zabSideFD == 0 and strategy.position_size == 0)

if c4CanCreateNew
    if c4LongReady
        c4SignalBar := bar_index
        c4FillBar   := na
        c4Side      := 1
        c4RiskAmt   := (c4VAL - low) + MNQ_TICK
        c4Entry     := math.round_to_mintick(c4VAL)
        c4Stop      := math.round_to_mintick(low) - MNQ_TICK
        c4Target    := c4Entry + 2.0 * c4RiskAmt
        c4Qty       := math.min(math.max(1, math.floor(i_c4Risk / (math.max(c4RiskAmt, MNQ_TICK) * MNQ_POINT))), MAX_CONTRACTS)
    else if c4ShortReady
        c4SignalBar := bar_index
        c4FillBar   := na
        c4Side      := -1
        c4RiskAmt   := (high - c4VAH) + MNQ_TICK
        c4Entry     := math.round_to_mintick(c4VAH)
        c4Stop      := math.round_to_mintick(high) + MNQ_TICK
        c4Target    := c4Entry - 2.0 * c4RiskAmt
        c4Qty       := math.min(math.max(1, math.floor(i_c4Risk / (math.max(c4RiskAmt, MNQ_TICK) * MNQ_POINT))), MAX_CONTRACTS)

// PENDING — recompute after signal-side mutation on this bar
c4HasPending := (c4Side != 0 and strategy.position_size == 0 and strategy.opentrades == 0)
if c4Side == 1 and c4HasPending and c4Qty >= 1 and
   not na(c4SignalBar) and (bar_index - c4SignalBar) <= i_c4MaxPending
    strategy.entry("C4_L", strategy.long,  limit=c4Entry, qty=c4Qty, comment="C4")
    strategy.exit ("C4_LX","C4_L", stop=c4Stop, limit=c4Target,
                   comment_loss="C4", comment_profit="C4")
if c4Side == -1 and c4HasPending and c4Qty >= 1 and
   not na(c4SignalBar) and (bar_index - c4SignalBar) <= i_c4MaxPending
    strategy.entry("C4_S", strategy.short, limit=c4Entry, qty=c4Qty, comment="C4")
    strategy.exit ("C4_SX","C4_S", stop=c4Stop, limit=c4Target,
                   comment_loss="C4", comment_profit="C4")

// Invalidation BEFORE fill
if c4Side == 1 and c4HasPending and close < c4Entry - MNQ_TICK
    strategy.cancel("C4_L")
    nC4Invalidations += 1
    c4Side := 0
    c4SignalBar := na
if c4Side == -1 and c4HasPending and close > c4Entry + MNQ_TICK
    strategy.cancel("C4_S")
    nC4Invalidations += 1
    c4Side := 0
    c4SignalBar := na

// Expiry (pending age > max pending)
if c4Side != 0 and c4HasPending and
   not na(c4SignalBar) and (bar_index - c4SignalBar) > i_c4MaxPending
    strategy.cancel(c4Side == 1 ? "C4_L" : "C4_S")
    nC4Expirations += 1
    c4Side := 0
    c4SignalBar := na

// Fill detection — stamp fill bar exactly once
if c4IsOpen and na(c4FillBar)
    c4FillBar := bar_index

// Max-hold FROM FILL
if c4Side == 1 and c4IsOpen and not na(c4FillBar) and (bar_index - c4FillBar) > i_c4MaxHold
    strategy.close("C4_L", comment="C4-TIMEOUT")
if c4Side == -1 and c4IsOpen and not na(c4FillBar) and (bar_index - c4FillBar) > i_c4MaxHold
    strategy.close("C4_S", comment="C4-TIMEOUT")

// Release on confirmed close — only when NOT pending
if c4Side != 0 and strategy.position_size == 0 and not na(c4FillBar)
    c4Side := 0
    c4SignalBar := na
    c4FillBar   := na

_c4SideFD := c4Side

// =====================================================================
// PRIME — D00055
//   Local 3m auction/profile. Out-of-balance -> newly-settled profile
//   whose POC remains outside PRIOR buffered VA. Next actual 1m open
//   after the completed 3m signal becomes the entry. Target = nearest
//   untouched 15m FVG in trade direction. Stop = 1 tick beyond PRIOR
//   auction POC on the invalid side. Max hold 240m from fill. Force
//   flat by 16:45 NY. Risk budget $500.
// =====================================================================
// === PRIME_BUFFER_PARITY_CHECK ===
// PRIME_CANONICAL_DETAIL_REQUIRED
// The exact original buffered-VA construction used by the canonical
// AMT Core helper is a known parity checkpoint. The current build uses
// raw PRIOR VA edges (buffer = 0). The `nPrimeUnresolved` counter
// increments whenever the PRIOR VA is unavailable so the parity gap
// is visible on the dashboard. To plug a buffer in once the canonical
// source is recovered, modify the [bVAH, bVAL] = line below.
var int nPrimeUnresolved = 0
var float primePriorPOC    = na
var float primePriorVAH    = na
var float primePriorVAL    = na
var float primePriorVAW    = na
var bool  primeOutOfBalance = false
var int   primeOOBside     = 0
var float primeAcceptanceVAH = na
var float primeAcceptanceVAL = na
var float primeAcceptancePOC = na
var float primeAcceptanceVAW = na

if enablePrime and new3mCandle
    // 9 completed 3m bars ≈ 27 1m bars (the documented minimum balance)
    [pp, hh, ll, _, _, _, _] = buildVP(27, 30, i_c4VA)
    // PRIME_BUFFER_PARITY_CHECK: replace raw edges with buffered VA when known
    bVAH = hh
    bVAL = ll
    primeOutOfBalance := false
    primeOOBside := 0
    if not na(primePriorPOC) and not na(bVAH) and not na(bVAL)
        if pp > primePriorVAH
            primeOutOfBalance := true
            primeOOBside     := 1
            primeAcceptanceVAH := primePriorVAH
            primeAcceptanceVAL := primePriorVAL
            primeAcceptancePOC := primePriorPOC
            primeAcceptanceVAW := primePriorVAW
        else if pp < primePriorVAL
            primeOutOfBalance := true
            primeOOBside     := -1
            primeAcceptanceVAH := primePriorVAH
            primeAcceptanceVAL := primePriorVAL
            primeAcceptancePOC := primePriorPOC
            primeAcceptanceVAW := primePriorVAW
    primePriorPOC := pp
    primePriorVAH := bVAH
    primePriorVAL := bVAL
    primePriorVAW := bVAH - bVAL

// Completed 3m close — read from prior 1m bar of the HTF (causal)
htf3_c0 = request.security(syminfo.tickerid, "3", close[1], lookahead=barmerge.lookahead_off)

primeLongAccept  = enablePrime and inPrimeSession and
                   not na(primePriorPOC) and not na(primePriorVAH) and
                   new3mCandle and primeOOBside == 1 and
                   htf3_c0 > primeAcceptanceVAH
primeShortAccept = enablePrime and inPrimeSession and
                   not na(primePriorPOC) and not na(primePriorVAL) and
                   new3mCandle and primeOOBside == -1 and
                   htf3_c0 < primeAcceptanceVAL

if not enablePrime or not inPrimeSession or na(primePriorPOC)
    nPrimeUnresolved += 0   // placeholder for parity instrumentation

// Magnet: nearest untouched 15m FVG in trade direction
var float primeLongMagnetTop   = na
var float primeLongMagnetBot   = na
var float primeLongMagDist     = 1e20
var float primeShortMagnetTop  = na
var float primeShortMagnetBot  = na
var float primeShortMagDist    = 1e20

if primeLongAccept
    [iL, dL] = fvgNearestAhead(fvg15T, fvg15B, fvg15D,  1, close, 1e20)
    if iL >= 0
        primeLongMagnetTop := array.get(fvg15T, iL)
        primeLongMagnetBot := array.get(fvg15B, iL)
        primeLongMagDist   := dL
    else
        primeLongMagnetTop := na
        primeLongMagnetBot := na
        primeLongMagDist   := 1e20
else
    primeLongMagnetTop  := na
    primeLongMagnetBot  := na
    primeLongMagDist    := 1e20

if primeShortAccept
    [iS, dS] = fvgNearestAhead(fvg15T, fvg15B, fvg15D, -1, close, 1e20)
    if iS >= 0
        primeShortMagnetTop := array.get(fvg15T, iS)
        primeShortMagnetBot := array.get(fvg15B, iS)
        primeShortMagDist   := dS
    else
        primeShortMagnetTop := na
        primeShortMagnetBot := na
        primeShortMagDist   := 1e20
else
    primeShortMagnetTop  := na
    primeShortMagnetBot  := na
    primeShortMagDist    := 1e20

primeLongTargetOK  = primeLongAccept  and not na(primeLongMagnetBot) and
                     not na(primePriorVAW) and (primeLongMagnetBot - close) <= i_primeMaxTarget * primeAcceptanceVAW
primeShortTargetOK = primeShortAccept and not na(primeShortMagnetTop) and
                     not na(primePriorVAW) and (close - primeShortMagnetTop) <= i_primeMaxTarget * primeAcceptanceVAW

primeLongRaw  = primeLongTargetOK
primeShortRaw = primeShortTargetOK

// =====================================================================
// PRIME — ORDER MANAGEMENT — explicit lifecycle: IDLE -> PENDING -> OPEN
//   Prime does not use a resting limit. On the bar that completes the
//   3m acceptance, the setup enters PENDING and the entry market order
//   is submitted on the NEXT 1m bar at that bar's `open`. While
//   PENDING, the portfolio is FLAT and the slot is held.
// =====================================================================
var int  primeSignalBar  = na
var int  primeFillBar    = na
var int  primeSide       = 0
var int  primeQty        = 0
var float primeEntry     = na
var float primeStop      = na
var float primeTarget    = na
var float primeRiskAmt   = 0.0

primeIsOpen      = (primeSide != 0 and strategy.position_size != 0)
primeHasPending  = (primeSide != 0 and strategy.position_size == 0 and strategy.opentrades == 0)
primeCanCreateNew = (primeSide == 0 and _c4SideFD == 0 and _primeSideFD == 0 and _zabSideFD == 0 and strategy.position_size == 0)

// Signal stamped on the bar that completes the 3m acceptance.
// Market order is submitted on the signal bar and expected to fill next 1m open.
// Quantity is estimated from signal close, not the as-yet-unknown next open.
if primeCanCreateNew
    if primeLongRaw
        primeSignalBar := bar_index
        primeFillBar   := na
        primeSide      := 1
        primeEntry     := na
        primeStop      := math.round_to_mintick(primeAcceptancePOC) - MNQ_TICK
        primeRiskAmt   := na
        primeQty       := 0
        primeTarget    := primeLongMagnetBot
    else if primeShortRaw
        primeSignalBar := bar_index
        primeFillBar   := na
        primeSide      := -1
        primeEntry     := na
        primeStop      := math.round_to_mintick(primeAcceptancePOC) + MNQ_TICK
        primeRiskAmt   := na
        primeQty       := 0
        primeTarget    := primeShortMagnetTop

// PRIME EXECUTION TIMING REPAIR: submit at signal-bar close for next-bar-open market fill.
// Actual next open is unknown at sizing time: signal close is a sizing proxy,
// so exact Python next-open quantity parity remains UNVERIFIED.
// Refresh pending after signal-side mutation on this same calculation.
primeHasPending := (primeSide != 0 and strategy.position_size == 0 and strategy.opentrades == 0)
// On the SIGNAL bar: estimate entry from close, compute risk and qty.
if primeSide != 0 and primeHasPending and na(primeEntry) and
   not na(primeSignalBar) and (bar_index - primeSignalBar) == 0
    if primeSide == 1
        primeEntry   := close
        primeRiskAmt := primeEntry - primeStop
    else
        primeEntry   := close
        primeRiskAmt := primeStop - primeEntry
    if not na(primeRiskAmt) and primeRiskAmt > 0
        primeQty := math.min(math.max(1, math.floor(i_primeRisk / (primeRiskAmt * MNQ_POINT))), MAX_CONTRACTS)
    else
        primeQty := 0

// Submit on the signal bar; broker emulator normally fills market order at next 1m open.
if primeSide != 0 and primeHasPending and primeQty >= 1 and
   not na(primeEntry) and
   not na(primeSignalBar) and (bar_index - primeSignalBar) == 0
    if primeSide == 1
        strategy.entry("PRIME_L", strategy.long,  qty=primeQty, comment="PRIME")
        strategy.exit ("PRIME_LX","PRIME_L", stop=primeStop, limit=primeTarget,
                       comment_loss="PRIME", comment_profit="PRIME")
    else
        strategy.entry("PRIME_S", strategy.short, qty=primeQty, comment="PRIME")
        strategy.exit ("PRIME_SX","PRIME_S", stop=primeStop, limit=primeTarget,
                       comment_loss="PRIME", comment_profit="PRIME")

// qty<1: do not submit. Same-bar block.
if primeSide != 0 and primeHasPending and primeQty < 1 and not na(primeEntry)
    nPortfolioQtyZero += 1
    primeSide := 0
    primeSignalBar := na
    primeFillBar   := na

// Fill detection — stamp fill bar exactly once
if primeIsOpen and na(primeFillBar)
    primeFillBar := bar_index

// Max-hold FROM FILL
if primeSide == 1 and primeIsOpen and not na(primeFillBar) and (bar_index - primeFillBar) > i_primeMaxHold
    strategy.close("PRIME_L", comment="PRIME-TIMEOUT")
if primeSide == -1 and primeIsOpen and not na(primeFillBar) and (bar_index - primeFillBar) > i_primeMaxHold
    strategy.close("PRIME_S", comment="PRIME-TIMEOUT")

if primeForceFlatBar and primeIsOpen
    strategy.close(primeSide == 1 ? "PRIME_L" : "PRIME_S", comment="PRIME-EOD")

// Release on confirmed close — only when NOT pending
if primeSide != 0 and strategy.position_size == 0 and not na(primeFillBar)
    primeSide := 0
    primeSignalBar := na
    primeFillBar   := na

_primeSideFD := primeSide

// =====================================================================
// ZAB-02A — Frozen 180m Profile + directional POC cross + retest
// =====================================================================
var float zabPOC  = na
var float zabVAH  = na
var float zabVAL  = na
var int   zabFreezeBar = na

zabNeedBars = math.max(i_zabVPBars, 60)
if enableZAB and new180mCandle
    [pp, hh, ll, tV, vaV, rH, rL] = buildVP(zabNeedBars, i_zabBins, i_zabVA)
    zabPOC := pp
    zabVAH := hh
    zabVAL := ll
    zabFreezeBar := bar_index

// ZAB_RELVOL_PARITY_CHECK
//   The exact original ZAB 15m RelVol denominator alignment is a known
//   parity checkpoint. The current implementation uses the prior-20
//   mean construction (numerator explicitly excluded). If the
//   canonical source uses a different alignment (e.g. 15m-candle-local
//   volume SMA without the explicit exclusion), flip the constant
//   `ZAB_RELVOL_USE_EXPLICIT_EXCLUSION` below to false and use
//   ta.sma(volume[1], 20) instead.
ZAB_RELVOL_USE_EXPLICIT_EXCLUSION = true

// Cooldown tracking
var int lastZabExitBar = na
cooldownActiveZab = enableZAB and not na(lastZabExitBar) and (bar_index - lastZabExitBar) < i_zabCooldown

zabLongCross  = (enableZAB and not cooldownActiveZab and not na(zabPOC) and
                 close[1] <= zabPOC and close > zabPOC and close > open)
zabShortCross = (enableZAB and not cooldownActiveZab and not na(zabPOC) and
                 close[1] >= zabPOC and close < zabPOC and close < open)

zabLongStruct  = (zabPOC - low) + MNQ_TICK
zabShortStruct = (high  - zabPOC) + MNQ_TICK
zabLongStructOK  = zabLongCross  and zabLongStruct  >= i_zabStructMin * atr14
zabShortStructOK = zabShortCross and zabShortStruct >= i_zabStructMin * atr14

// Cooldown evaluated BEFORE RelVol
zabLongCDOK  = zabLongCross  and zabLongStructOK
zabShortCDOK = zabShortCross and zabShortStructOK
zabLongRelVolOK  = zabLongCDOK  and not na(relvol15) and relvol15 >= i_zabMinRelVol
zabShortRelVolOK = zabShortCDOK and not na(relvol15) and relvol15 >= i_zabMinRelVol

zabLongReady  = zabLongRelVolOK  and strategy.position_size == 0 and strategy.opentrades == 0 and passFundedAll
zabShortReady = zabShortRelVolOK and strategy.position_size == 0 and strategy.opentrades == 0 and passFundedAll

// =====================================================================
// ZAB — ORDER MANAGEMENT — explicit lifecycle: IDLE -> PENDING -> OPEN
//   Resting limit at the frozen POC. State is driven off zabSide, not
//   off strategy.position_size alone. Pending invalidation: wrong-side
//   close >1 tick through the entry edge cancels the resting order.
// =====================================================================
var int   zabSigBar     = na
var int   zabFillBar    = na
var int   zabSide       = 0
var int   zabQty        = 0
var float zabEntry      = na
var float zabStop       = na
var float zabTarget     = na
var float zabRiskAmt    = 0.0

zabIsOpen      = (zabSide != 0 and strategy.position_size != 0)
zabHasPending  = (zabSide != 0 and strategy.position_size == 0 and strategy.opentrades == 0)
zabCanCreateNew = (zabSide == 0 and _c4SideFD == 0 and _primeSideFD == 0 and _zabSideFD == 0 and strategy.position_size == 0)

if zabCanCreateNew
    if zabLongReady
        zabSigBar  := bar_index
        zabFillBar := na
        zabSide    := 1
        zabRiskAmt := (zabPOC - low) + MNQ_TICK
        zabEntry   := math.round_to_mintick(zabPOC)
        zabStop    := math.round_to_mintick(low) - MNQ_TICK
        zabTarget  := zabEntry + 1.5 * zabRiskAmt
        if (zabEntry - zabStop) > 0
            zabQty := math.min(math.max(1, math.floor(i_zabRisk / ((zabEntry - zabStop) * MNQ_POINT))), MAX_CONTRACTS)
        else
            zabQty := 0
    else if zabShortReady
        zabSigBar  := bar_index
        zabFillBar := na
        zabSide    := -1
        zabRiskAmt := (high - zabPOC) + MNQ_TICK
        zabEntry   := math.round_to_mintick(zabPOC)
        zabStop    := math.round_to_mintick(high) + MNQ_TICK
        zabTarget  := zabEntry - 1.5 * zabRiskAmt
        if (zabStop - zabEntry) > 0
            zabQty := math.min(math.max(1, math.floor(i_zabRisk / ((zabStop - zabEntry) * MNQ_POINT))), MAX_CONTRACTS)
        else
            zabQty := 0

// PENDING — recompute after signal-side mutation on this bar
zabHasPending := (zabSide != 0 and strategy.position_size == 0 and strategy.opentrades == 0)
if zabSide == 1 and zabHasPending and zabQty >= 1 and
   not na(zabSigBar) and (bar_index - zabSigBar) <= i_zabRetestBars
    strategy.entry("ZAB_L", strategy.long,  limit=zabEntry, qty=zabQty, comment="ZAB")
    strategy.exit ("ZAB_LX","ZAB_L", stop=zabStop, limit=zabTarget,
                   comment_loss="ZAB", comment_profit="ZAB")
if zabSide == -1 and zabHasPending and zabQty >= 1 and
   not na(zabSigBar) and (bar_index - zabSigBar) <= i_zabRetestBars
    strategy.entry("ZAB_S", strategy.short, limit=zabEntry, qty=zabQty, comment="ZAB")
    strategy.exit ("ZAB_SX","ZAB_S", stop=zabStop, limit=zabTarget,
                   comment_loss="ZAB", comment_profit="ZAB")

// Invalidation: long candidate's wrong side is ABOVE POC
if zabSide == 1 and zabHasPending and close < zabEntry - MNQ_TICK
    strategy.cancel("ZAB_L")
    nZabInvalidations += 1
    zabSide := 0
    zabSigBar := na
// Invalidation: short candidate's wrong side is BELOW POC
if zabSide == -1 and zabHasPending and close > zabEntry + MNQ_TICK
    strategy.cancel("ZAB_S")
    nZabInvalidations += 1
    zabSide := 0
    zabSigBar := na

// Expiry — pending retest window elapsed without valid fill
if zabSide != 0 and zabHasPending and
   not na(zabSigBar) and (bar_index - zabSigBar) > i_zabRetestBars
    strategy.cancel(zabSide == 1 ? "ZAB_L" : "ZAB_S")
    nZabExpirations += 1
    zabSide := 0
    zabSigBar := na

// qty<1: do not submit
if zabSide != 0 and zabHasPending and zabQty < 1
    nPortfolioQtyZero += 1
    strategy.cancel(zabSide == 1 ? "ZAB_L" : "ZAB_S")
    zabSide := 0
    zabSigBar := na

// Fill detection — stamp fill bar exactly once
if zabIsOpen and na(zabFillBar)
    zabFillBar := bar_index

// Max-hold FROM FILL
if zabSide == 1 and zabIsOpen and not na(zabFillBar) and (bar_index - zabFillBar) > i_zabMaxHold
    strategy.close("ZAB_L", comment="ZAB-TIMEOUT")
if zabSide == -1 and zabIsOpen and not na(zabFillBar) and (bar_index - zabFillBar) > i_zabMaxHold
    strategy.close("ZAB_S", comment="ZAB-TIMEOUT")

// Release on confirmed close — only when NOT pending
if zabSide != 0 and strategy.position_size == 0 and not na(zabFillBar)
    zabSide := 0
    zabSigBar := na
    zabFillBar := na

// Mirror C4's current-bar side so Prime/ZAB can see it in their gates.
_c4SideFD := c4Side

// Conflict detection: if C4 just claimed the slot and Prime/ZAB also had
// valid signals this bar, count the conflict.
if c4Side != 0 and c4Side[1] == 0
    if (primeLongRaw or primeShortRaw) or (zabLongCross or zabShortCross)
        nSimultaneousConflicts += 1

// Mirror Prime's current-bar side so ZAB can see it in its gate.
_primeSideFD := primeSide

if primeSide != 0 and primeSide[1] == 0
    if (c4LongReady or c4ShortReady) or (zabLongCross or zabShortCross)
        nSimultaneousConflicts += 1

_zabSideFD := zabSide

if zabSide != 0 and zabSide[1] == 0
    if (c4LongReady or c4ShortReady) or (primeLongRaw or primeShortRaw)
        nSimultaneousConflicts += 1

// =====================================================================
// GLOBAL ZAC PORTFOLIO ROUTER — CURRENT-BAR STATE
//   The portfolio slot must be free BEFORE any module can claim it.
//   The forward-declared _c4SideFD / _primeSideFD / _zabSideFD are
//   updated immediately after each module's signal block, so by the
//   time the next module's block runs, the current-bar state of the
//   earlier module is visible. This enforces router priority: C4
//   evaluates first, then Prime, then ZAB.
// =====================================================================
var bool _prevPortfolioBusy = false
_prevPortfolioBusy := (c4Side[1] != 0 or primeSide[1] != 0 or zabSide[1] != 0)
portfolioSlotFree = not _prevPortfolioBusy

// =====================================================================
// FUNDED-MODE CONTROLS — REFERENCE mode must NOT be affected
// =====================================================================
nTot = strategy.closedtrades
if nTot > fundedLastTradeCount
    for i = fundedLastTradeCount to nTot - 1
        pnl = strategy.closedtrades.profit(i)
        dailyPnl += pnl
        cumPnl   += pnl
    fundedLastTradeCount := nTot

// Day-rollover (NY 00:00) — ta.change must be evaluated every bar
_rolloverCheck = time("1", "0000-0001", nyTz)
rolloverDelta = ta.change(_rolloverCheck)
newDayFunded = not barstate.isfirst and rolloverDelta > 0
if newDayFunded
    if dailyPnl > bestDayPnl
        bestDayPnl := dailyPnl
    dailyPnl := 0.0

// EOD trailing drawdown — floor trails UPWARD only
if eodBar
    peakEODEquity := math.max(peakEODEquity, strategy.equity)
    newFloor      = peakEODEquity - 1000.0
    newFloor      := math.min(newFloor, 25000.0)
    if newFloor > trailingFloor
        trailingFloor := newFloor

hardProfitHit   = useFunded and strategy.equity >= profitTarget
hardDailyLoss   = useFunded and dailyPnl <= maxDailyLoss
hardTrailHit    = useFunded and strategy.equity <= trailingFloor
hardDailyProfit = useFunded and dailyPnl >= maxDayProfit
effectiveBestDay = math.max(bestDayPnl, dailyPnl)
consistency50   = false  // No unverified consistency gate in the funded specification.

fundedBlockNewEntries := hardProfitHit or hardDailyLoss or hardTrailHit or hardDailyProfit or consistency50

// EOD flatten (gated on a parity-check input; default OFF for C4/ZAB).
// Prime 16:45 NY force-flat is documented and always active.
// C4/ZAB EOD flatten time is a known parity checkpoint — see
// C4_FLAT_TIME_PARITY_CHECK and ZAB_FLAT_TIME_PARITY_CHECK markers.
flattenAtEOD = input.bool(false, "Universal EOD flatten (C4/ZAB — parity CHECK)", group=gDiag)
if eodBar and flattenAtEOD
    strategy.cancel("C4_L")
    strategy.cancel("C4_S")
    strategy.cancel("ZAB_L")
    strategy.cancel("ZAB_S")
    if strategy.position_size != 0
        strategy.close_all(comment="EOD-FLATTEN")

// =====================================================================
// C4_FLAT_TIME_PARITY_CHECK
//   Canonical EOD/flatten time for C4 (D00054) is a known parity
//   checkpoint. The current build does NOT auto-flatten C4 at EOD.
//   If the canonical source requires a session-flat time, expose it as
//   an input and add the strategy.close("C4_L"/"C4_S") call here.
// =====================================================================

// =====================================================================
// ZAB_FLAT_TIME_PARITY_CHECK
//   Canonical EOD/flatten time for ZAB (D00064) is a known parity
//   checkpoint. The current build does NOT auto-flatten ZAB at EOD.
//   If the canonical source requires a session-flat time, expose it as
//   an input and add the strategy.close("ZAB_L"/"ZAB_S") call here.
// =====================================================================

// =====================================================================
// DIAGNOSTIC COUNTERS — wired below (declarations are above the modules
// so the per-module state machines can increment them at the moment the
// event happens).
// =====================================================================

if new5mCandle and enableC4
    nC4ProfileFreeze += 1
if c4Balanced
    nC4Balanced += 1
if c4LongRaw or c4ShortRaw
    nC4Rejection += 1
if c4LongRaw or c4ShortRaw
    nC4Displacement += 1
if c4LongValidFVG or c4ShortValidFVG
    nC4FVG += 1
if c4LongRV or c4ShortRV
    nC4RV += 1
if (c4LongStructOK and c4LongRV) or (c4ShortStructOK and c4ShortRV)
    nC4StructOK += 1
if c4Side != 0 and c4Side[1] == 0
    nC4Orders += 1

if enablePrime and new3mCandle
    nPrimeBalances += 1
if primeLongAccept or primeShortAccept
    nPrimeAccepts += 1
if primeOutOfBalance
    nPrimePOCmigrate += 1
if (primeLongAccept and not na(primeLongMagnetBot)) or (primeShortAccept and not na(primeShortMagnetTop))
    nPrimeFVG += 1
if primeLongTargetOK or primeShortTargetOK
    nPrimeTgtOK += 1
if primeSide != 0 and primeSide[1] == 0
    nPrimeOrders += 1

// Edge-event counters — derived from state transitions, fired same bar
c4JustFilled   = c4Side != 0 and strategy.position_size != 0 and na(c4FillBar[1])
primeJustFilled = primeSide != 0 and strategy.position_size != 0 and na(primeFillBar[1])
zabJustFilled   = zabSide != 0 and strategy.position_size != 0 and na(zabFillBar[1])
if c4JustFilled
    nC4Fills += 1
if primeJustFilled
    nPrimeFills += 1
if zabJustFilled
    nZabFills += 1

// C4 invalidation/expiry — fired when side was reset this bar from a
// non-zero state with no position open
// C4 cancellation counters are incremented at the actual cancellation event.
// ZAB invalidation/expiry — same pattern
// ZAB cancellation counters are incremented at the actual cancellation event.

if enableZAB and (zabLongCross or zabShortCross)
    nZabPOCcross += 1
if (zabLongCDOK or zabShortCDOK) and not cooldownActiveZab
    nZabCDpass += 1
if cooldownActiveZab
    nZabCDblock += 1
if (zabLongRelVolOK or zabShortRelVolOK)
    nZabRVpass += 1
if zabSide != 0 and zabSide[1] == 0
    nZabOrders += 1

if (c4Side != 0 or primeSide != 0 or zabSide != 0) and strategy.position_size == 0
    nPortfolioPending += 1
// Qty-zero counter is incremented only when an actual order candidate fails sizing.
if fundedBlockNewEntries
    nFundedBlocks += 1

// =====================================================================
// CLOSED-TRADE LEDGER
//   Process strategy.closedtrades > nLastCT in a LOOP, not just the
//   latest, so same-bar round trips (one trade closes AND a new one
//   opens) are both accounted for. Attribution is by entry_comment.
// =====================================================================
nClosed = strategy.closedtrades
if nClosed > nLastCT
    for i = nLastCT to nClosed - 1
        lastMod = strategy.closedtrades.entry_comment(i)
        if lastMod == "C4"
            nLastModule := 1
            nC4Closed  += 1
        else if lastMod == "PRIME"
            nLastModule := 2
            nPrimeClosed += 1
        else if lastMod == "ZAB"
            nLastModule := 3
            nZabClosed  += 1
            lastZabExitBar := bar_index
    nLastCT := nClosed

// =====================================================================
// PLOTS — optional frozen VP edges for visual parity debugging
// =====================================================================
plot(showVPFill ? c4POC : na, "C4 POC", color=color.orange, linewidth=1, style=plot.style_circles)
plot(showVPFill ? c4VAH : na, "C4 VAH", color=color.green,  linewidth=1, style=plot.style_circles)
plot(showVPFill ? c4VAL : na, "C4 VAL", color=color.red,    linewidth=1, style=plot.style_circles)
plot(showVPFill ? zabPOC : na, "ZAB POC", color=color.purple, linewidth=1, style=plot.style_cross)

// =====================================================================
// DIAGNOSTIC DASHBOARD
// =====================================================================
if showDash and barstate.islast
    var table d = table.new(position.top_right, 2, 30,
         bgcolor=color.new(color.black, 70), border_width=1)
    r = 0
    table.cell(d, 0, r, "ZAC", text_color=color.yellow)
    table.cell(d, 1, r, useFunded ? "FUNDED" : "REF",   text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 sess",       text_color=color.orange)
    table.cell(d, 1, r, str.tostring(inC4Session),   text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime sess",    text_color=color.orange)
    table.cell(d, 1, r, str.tostring(inPrimeSession),text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 profile",    text_color=color.orange)
    table.cell(d, 1, r, na(c4POC) ? "na" : str.tostring(c4POC, "#.##"), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 balanced",   text_color=color.orange)
    table.cell(d, 1, r, str.tostring(c4Balanced),     text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 disp",       text_color=color.orange)
    table.cell(d, 1, r, str.tostring(c4LongRaw or c4ShortRaw), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 FVG",        text_color=color.orange)
    table.cell(d, 1, r, str.tostring(c4LongValidFVG or c4ShortValidFVG), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 RV",         text_color=color.orange)
    table.cell(d, 1, r, str.tostring(c4LongRV or c4ShortRV), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 orders",     text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nC4Orders), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "C4 closed",     text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nC4Closed), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime bal",     text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nPrimeBalances), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime accept",  text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nPrimeAccepts), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime FVG",     text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nPrimeFVG), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime tdist",   text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nPrimeTgtOK), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime orders",  text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nPrimeOrders), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime closed",  text_color=color.orange)
    table.cell(d, 1, r, str.tostring(nPrimeClosed), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Prime unres",   text_color=color.yellow)
    table.cell(d, 1, r, str.tostring(nPrimeUnresolved), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB POC",       text_color=color.purple)
    table.cell(d, 1, r, na(zabPOC) ? "na" : str.tostring(zabPOC, "#.##"), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB cross",     text_color=color.purple)
    table.cell(d, 1, r, str.tostring(nZabPOCcross), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB CD pass",   text_color=color.purple)
    table.cell(d, 1, r, str.tostring(nZabCDpass), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB CD block",  text_color=color.purple)
    table.cell(d, 1, r, str.tostring(nZabCDblock), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB RV15",      text_color=color.purple)
    table.cell(d, 1, r, str.tostring(relvol15, "#.##"),text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB orders",    text_color=color.purple)
    table.cell(d, 1, r, str.tostring(nZabOrders), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "ZAB closed",    text_color=color.purple)
    table.cell(d, 1, r, str.tostring(nZabClosed), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Funded block",  text_color=color.aqua)
    table.cell(d, 1, r, str.tostring(fundedBlockNewEntries), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Trail floor",   text_color=color.aqua)
    table.cell(d, 1, r, str.tostring(trailingFloor, "#.##"), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Pos",           text_color=color.yellow)
    table.cell(d, 1, r, str.tostring(strategy.position_size), text_color=color.white)
    r += 1
    table.cell(d, 0, r, "Trades",        text_color=color.yellow)
    table.cell(d, 1, r, str.tostring(strategy.closedtrades), text_color=color.white)
