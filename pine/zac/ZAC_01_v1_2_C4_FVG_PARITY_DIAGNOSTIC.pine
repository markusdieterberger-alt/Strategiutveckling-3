//@version=6
strategy(
     "ZAC-01 v1.2 — C4 FVG PARITY",
     overlay = true,
     pyramiding = 0,
     process_orders_on_close = false,
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     initial_capital = 25000,
     margin_long = 0,
     margin_short = 0,
     max_bars_back = 5000,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.50,
     slippage = 1
)


// ============================================================================
// ZAC-01 v1.2 — C4 FVG PARITY
//
// PURPOSE
// -------
// v1.1 isolated the parity break:
// RAW 114 -> displacement 95 -> directional FVG 0.
//
// ROOT-CAUSE CANDIDATE FIXED HERE
// --------------------------------
// Old FVG prune logic used:
//   bullish: low <= gapHigh
//   bearish: high >= gapLow
//
// That is NOT a true zone-touch test. A bullish FVG sitting ABOVE price can be
// deleted merely because low <= gapHigh, even when the bar never reaches the
// gap. Likewise a bearish FVG below price can be deleted while price remains
// entirely above it.
//
// Correct untouched-zone invalidation requires actual overlap:
//   high >= gapLow AND low <= gapHigh
//
// This is an implementation bug fix, not threshold optimization.
//
// DIAGNOSTIC
// ----------
// Dashboard shows BOTH:
//   ANY-AHEAD = any untouched 1H/4H FVG in trade direction by LOCATION.
//   SAME-TYPE = bullish FVG for long / bearish FVG for short.
//
// Default execution semantic = ANY_AHEAD because the original strategy concept
// treats FVG as a magnet ahead of price. This setting can be switched without
// changing thresholds.
//
// TEST
// ----
// MNQ1! / standard 1m / Deep Backtest
// 2019-05-05 -> 2026-10-02
// Mode = REFERENCE
// C4 only
//
// Reference fingerprint:
// ~376 trades / PF ~2.04
// ============================================================================




// ============================================================================
// SETTINGS
// ============================================================================


string G1 = "01 — Modules"
bool USE_C4    = input.bool(true,  "C4 / D00054", group = G1)
bool USE_PRIME = input.bool(false, "Prime (disabled in v1.2 diagnostic)", group = G1)
bool USE_ZAB   = input.bool(false, "ZAB (disabled in v1.2 diagnostic)", group = G1)


string G2 = "02 — Parity"
string RUN_MODE = input.string(
     "REFERENCE",
     "Mode",
     options = ["REFERENCE", "FUNDED"],
     group = G2
)


string FVG_SEMANTIC = input.string(
     "ANY_AHEAD",
     "C4 FVG semantic",
     options = ["ANY_AHEAD", "SAME_TYPE"],
     group = G2,
     tooltip = "ANY_AHEAD = any untouched 1H/4H FVG ahead of trade. SAME_TYPE = bullish FVG for long, bearish FVG for short."
)


string G3 = "03 — Frozen risk"
float C4_RISK_USD = input.float(350.0, "C4 nominal risk USD", step = 25, group = G3)
int MAX_MNQ = input.int(20, "Max MNQ", minval = 1, maxval = 20, group = G3)


string G4 = "04 — Display"
bool SHOW_LEVELS = input.bool(false, "Show VAH / VAL / POC", group = G4)
bool SHOW_EVENTS = input.bool(false, "Show event markers", group = G4)
bool SHOW_DASH = input.bool(true, "Show mobile parity dashboard", group = G4)




// ============================================================================
// GUARD + CONSTANTS
// ============================================================================


if barstate.isfirst
    if not chart.is_standard
        runtime.error("Use standard candles.")
    if not timeframe.isminutes
        runtime.error("Use 1-minute chart.")
    if timeframe.multiplier != 1
        runtime.error("Use 1-minute chart.")


string TZ_CT = "America/Chicago"


float TICK = syminfo.mintick
float MNQ_POINT_VALUE = 2.0


int VP_N = 180
int VP_BINS = 60
float VP_VA = 0.70


float C4_MIN_RISK_ATR = 0.25
float C4_MAX_FVG_ATR = 8.0
float C4_DISP_ATR = 0.10
float C4_REL5_MIN = 1.0
int C4_RETEST_MAX = 10
int C4_MAX_HOLD = 120




// ============================================================================
// HELPERS
// ============================================================================


f_qty(float entryPx, float stopPx, float riskUsd) =>
    float riskPts = math.abs(entryPx - stopPx)
    float usdPerContract = riskPts * MNQ_POINT_VALUE
    int q = 0
    if usdPerContract > 0
        q := int(math.floor(riskUsd / usdPerContract))
    math.max(0, math.min(MAX_MNQ, q))


f_yesno(bool v) =>
    v ? "YES" : "NO"


f_pf() =>
    float gl = math.abs(strategy.grossloss)
    gl > 0 ? strategy.grossprofit / gl : na




// ============================================================================
// 180m / 60-bin / 70% VALUE AREA
// ============================================================================


f_vp180() =>
    float profLow = 1e20
    float profHigh = -1e20
    float trSum = 0.0
    float previousClose = na


    for step = 0 to VP_N - 1
        int j = VP_N - step


        profLow := math.min(profLow, low[j])
        profHigh := math.max(profHigh, high[j])


        float tr = high[j] - low[j]


        if not na(previousClose)
            float gapH = math.abs(high[j] - previousClose)
            float gapL = math.abs(low[j] - previousClose)
            tr := math.max(tr, math.max(gapH, gapL))


        trSum += tr
        previousClose := close[j]


    float span = profHigh - profLow
    float binWidth = span / VP_BINS
    array<float> hist = array.new_float(VP_BINS, 0.0)


    if span > 0 and binWidth > 0
        for j = 1 to VP_N
            int firstBin = int(math.floor((low[j] - profLow) / binWidth))
            int lastBin = int(math.floor((high[j] - profLow) / binWidth))


            firstBin := math.max(0, math.min(VP_BINS - 1, firstBin))
            lastBin := math.max(0, math.min(VP_BINS - 1, lastBin))


            if lastBin < firstBin
                int tmp = firstBin
                firstBin := lastBin
                lastBin := tmp


            int touchedBins = math.max(1, lastBin - firstBin + 1)
            float volumePerBin = volume[j] / touchedBins


            for k = firstBin to lastBin
                array.set(hist, k, array.get(hist, k) + volumePerBin)


    float total = 0.0
    float maxVol = -1.0
    int pocBin = 0


    for k = 0 to VP_BINS - 1
        float v = array.get(hist, k)
        total += v


        if v > maxVol
            maxVol := v
            pocBin := k


    int vaLowBin = pocBin
    int vaHighBin = pocBin


    float accumulated = total > 0 ? array.get(hist, pocBin) : 0.0
    float vaTarget = total * VP_VA


    while accumulated < vaTarget and (vaLowBin > 0 or vaHighBin < VP_BINS - 1)
        float leftVol = vaLowBin > 0 ? array.get(hist, vaLowBin - 1) : -1.0
        float rightVol = vaHighBin < VP_BINS - 1 ? array.get(hist, vaHighBin + 1) : -1.0


        if rightVol > leftVol
            vaHighBin += 1
            accumulated += rightVol
        else
            vaLowBin -= 1
            accumulated += leftVol


    float val = profLow + vaLowBin * binWidth
    float vah = profLow + (vaHighBin + 1) * binWidth
    float poc = profLow + (pocBin + 0.5) * binWidth


    float avgTR = trSum / VP_N
    float compression = span / (avgTR * math.sqrt(VP_N) + 1e-12)
    float efficiency = math.abs(close[1] - open[VP_N]) / (span + 1e-12)


    int insideCount = 0


    for j = 1 to VP_N
        if close[j] >= val and close[j] <= vah
            insideCount += 1


    float insideRatio = float(insideCount) / VP_N


    [vah, val, poc, compression, efficiency, insideRatio]




int ctMinute = hour(time, TZ_CT) * 60 + minute(time, TZ_CT)
bool fiveBoundary = ctMinute % 5 == 0


var float vpVAH = na
var float vpVAL = na
var float vpPOC = na
var float vpComp = na
var float vpEff = na
var float vpInside = na


if fiveBoundary and bar_index > VP_N + 5
    [tmpVAH, tmpVAL, tmpPOC, tmpComp, tmpEff, tmpInside] = f_vp180()


    vpVAH := tmpVAH
    vpVAL := tmpVAL
    vpPOC := tmpPOC
    vpComp := tmpComp
    vpEff := tmpEff
    vpInside := tmpInside


bool vpBalanced =
     not na(vpVAH) and
     vpComp <= 1.0 and
     vpEff <= 0.35 and
     vpInside >= 0.65




// ============================================================================
// CAUSAL 5m RELVOL + ATR
// ============================================================================


float relVol5 = request.security(
     syminfo.tickerid,
     "5",
     volume[1] / ta.sma(volume[2], 20),
     lookahead = barmerge.lookahead_off
)


float atr1 = ta.atr(14)




// ============================================================================
// HTF FVG STORAGE
// ============================================================================


var array<float> f1Lo = array.new_float()
var array<float> f1Hi = array.new_float()
var array<int> f1Type = array.new_int()


var array<float> f4Lo = array.new_float()
var array<float> f4Hi = array.new_float()
var array<int> f4Type = array.new_int()


var int f1CreatedBull = 0
var int f1CreatedBear = 0
var int f4CreatedBull = 0
var int f4CreatedBear = 0


var int f1PrunedBull = 0
var int f1PrunedBear = 0
var int f4PrunedBull = 0
var int f4PrunedBear = 0




// ============================================================================
// CORRECT FVG PRUNING
//
// True touch = bar range overlaps gap zone.
// overlap iff:
//   high >= gapLow AND low <= gapHigh
// ============================================================================


int f1SizeBefore = array.size(f1Lo)


if f1SizeBefore > 0
    int i = f1SizeBefore - 1


    while i >= 0
        float gapLo = array.get(f1Lo, i)
        float gapHi = array.get(f1Hi, i)
        int gapType = array.get(f1Type, i)


        bool touched = high >= gapLo and low <= gapHi


        if touched
            array.remove(f1Lo, i)
            array.remove(f1Hi, i)
            array.remove(f1Type, i)


            if gapType == 1
                f1PrunedBull += 1
            else
                f1PrunedBear += 1


        i -= 1




int f4SizeBefore = array.size(f4Lo)


if f4SizeBefore > 0
    int i = f4SizeBefore - 1


    while i >= 0
        float gapLo = array.get(f4Lo, i)
        float gapHi = array.get(f4Hi, i)
        int gapType = array.get(f4Type, i)


        bool touched = high >= gapLo and low <= gapHi


        if touched
            array.remove(f4Lo, i)
            array.remove(f4Hi, i)
            array.remove(f4Type, i)


            if gapType == 1
                f4PrunedBull += 1
            else
                f4PrunedBear += 1


        i -= 1




// ============================================================================
// CREATE COMPLETED 1H / 4H FVGs
// Creation occurs AFTER pruning so the newly completed HTF gap cannot be
// deleted by the current 1m bar in the same calculation pass.
// ============================================================================


bool new1h = ta.change(time("60")) != 0
bool new4h = ta.change(time("240")) != 0


float h1Low1 = request.security(syminfo.tickerid, "60", low[1], lookahead = barmerge.lookahead_off)
float h1High1 = request.security(syminfo.tickerid, "60", high[1], lookahead = barmerge.lookahead_off)
float h1High3 = request.security(syminfo.tickerid, "60", high[3], lookahead = barmerge.lookahead_off)
float h1Low3 = request.security(syminfo.tickerid, "60", low[3], lookahead = barmerge.lookahead_off)


float h4Low1 = request.security(syminfo.tickerid, "240", low[1], lookahead = barmerge.lookahead_off)
float h4High1 = request.security(syminfo.tickerid, "240", high[1], lookahead = barmerge.lookahead_off)
float h4High3 = request.security(syminfo.tickerid, "240", high[3], lookahead = barmerge.lookahead_off)
float h4Low3 = request.security(syminfo.tickerid, "240", low[3], lookahead = barmerge.lookahead_off)


if new1h
    // Bullish FVG: older high < newer low.
    if h1Low1 > h1High3
        array.push(f1Lo, h1High3)
        array.push(f1Hi, h1Low1)
        array.push(f1Type, 1)
        f1CreatedBull += 1


    // Bearish FVG: newer high < older low.
    if h1High1 < h1Low3
        array.push(f1Lo, h1High1)
        array.push(f1Hi, h1Low3)
        array.push(f1Type, -1)
        f1CreatedBear += 1


if new4h
    if h4Low1 > h4High3
        array.push(f4Lo, h4High3)
        array.push(f4Hi, h4Low1)
        array.push(f4Type, 1)
        f4CreatedBull += 1


    if h4High1 < h4Low3
        array.push(f4Lo, h4High1)
        array.push(f4Hi, h4Low3)
        array.push(f4Type, -1)
        f4CreatedBear += 1




// ============================================================================
// ACTIVE FVG COUNTS
// ============================================================================


int active1Bull = 0
int active1Bear = 0
int active4Bull = 0
int active4Bear = 0


int active1Above = 0
int active1Below = 0
int active4Above = 0
int active4Below = 0


int n1 = array.size(f1Lo)


if n1 > 0
    for i = 0 to n1 - 1
        float gapLo = array.get(f1Lo, i)
        float gapHi = array.get(f1Hi, i)
        int gapType = array.get(f1Type, i)


        if gapType == 1
            active1Bull += 1
        else
            active1Bear += 1


        if gapLo > close
            active1Above += 1
        else if gapHi < close
            active1Below += 1




int n4 = array.size(f4Lo)


if n4 > 0
    for i = 0 to n4 - 1
        float gapLo = array.get(f4Lo, i)
        float gapHi = array.get(f4Hi, i)
        int gapType = array.get(f4Type, i)


        if gapType == 1
            active4Bull += 1
        else
            active4Bear += 1


        if gapLo > close
            active4Above += 1
        else if gapHi < close
            active4Below += 1




// ============================================================================
// NEAREST FVG — TWO SEMANTICS
// ============================================================================


// ANY_AHEAD:
// Long = nearest untouched gap above price, regardless of formation type.
// Short = nearest untouched gap below price, regardless of formation type.


float anyLongEdge = na
float anyLongDist = 1e20
int anyLongTF = 0
int anyLongType = 0


float anyShortEdge = na
float anyShortDist = 1e20
int anyShortTF = 0
int anyShortType = 0


// SAME_TYPE:
// Long = nearest bullish gap above price.
// Short = nearest bearish gap below price.


float sameLongEdge = na
float sameLongDist = 1e20
int sameLongTF = 0


float sameShortEdge = na
float sameShortDist = 1e20
int sameShortTF = 0




if n1 > 0
    for i = 0 to n1 - 1
        float gapLo = array.get(f1Lo, i)
        float gapHi = array.get(f1Hi, i)
        int gapType = array.get(f1Type, i)


        // Gap fully above price -> long magnet uses near/lower edge.
        float longDistTmp = gapLo - close


        if longDistTmp > 0
            if longDistTmp < anyLongDist
                anyLongDist := longDistTmp
                anyLongEdge := gapLo
                anyLongTF := 1
                anyLongType := gapType


            if gapType == 1 and longDistTmp < sameLongDist
                sameLongDist := longDistTmp
                sameLongEdge := gapLo
                sameLongTF := 1


        // Gap fully below price -> short magnet uses near/upper edge.
        float shortDistTmp = close - gapHi


        if shortDistTmp > 0
            if shortDistTmp < anyShortDist
                anyShortDist := shortDistTmp
                anyShortEdge := gapHi
                anyShortTF := 1
                anyShortType := gapType


            if gapType == -1 and shortDistTmp < sameShortDist
                sameShortDist := shortDistTmp
                sameShortEdge := gapHi
                sameShortTF := 1




if n4 > 0
    for i = 0 to n4 - 1
        float gapLo = array.get(f4Lo, i)
        float gapHi = array.get(f4Hi, i)
        int gapType = array.get(f4Type, i)


        float longDistTmp = gapLo - close


        if longDistTmp > 0
            if longDistTmp < anyLongDist
                anyLongDist := longDistTmp
                anyLongEdge := gapLo
                anyLongTF := 4
                anyLongType := gapType


            if gapType == 1 and longDistTmp < sameLongDist
                sameLongDist := longDistTmp
                sameLongEdge := gapLo
                sameLongTF := 4


        float shortDistTmp = close - gapHi


        if shortDistTmp > 0
            if shortDistTmp < anyShortDist
                anyShortDist := shortDistTmp
                anyShortEdge := gapHi
                anyShortTF := 4
                anyShortType := gapType


            if gapType == -1 and shortDistTmp < sameShortDist
                sameShortDist := shortDistTmp
                sameShortEdge := gapHi
                sameShortTF := 4




float execLongEdge = FVG_SEMANTIC == "ANY_AHEAD" ? anyLongEdge : sameLongEdge
float execLongDist = FVG_SEMANTIC == "ANY_AHEAD" ? anyLongDist : sameLongDist


float execShortEdge = FVG_SEMANTIC == "ANY_AHEAD" ? anyShortEdge : sameShortEdge
float execShortDist = FVG_SEMANTIC == "ANY_AHEAD" ? anyShortDist : sameShortDist




// ============================================================================
// C4 FUNNEL
// ============================================================================


bool c4Session = ctMinute >= 7 * 60 and ctMinute <= 14 * 60 + 29


bool rawLong =
     USE_C4 and
     c4Session and
     vpBalanced and
     low <= vpVAL and
     close > vpVAL and
     close > open


bool rawShort =
     USE_C4 and
     c4Session and
     vpBalanced and
     high >= vpVAH and
     close < vpVAH and
     close < open


bool dispLong = rawLong and close - vpVAL >= C4_DISP_ATR * atr1
bool dispShort = rawShort and vpVAH - close >= C4_DISP_ATR * atr1


bool anyFvgLong = dispLong and not na(anyLongEdge)
bool anyFvgShort = dispShort and not na(anyShortEdge)


bool sameFvgLong = dispLong and not na(sameLongEdge)
bool sameFvgShort = dispShort and not na(sameShortEdge)


bool execFvgLong = dispLong and not na(execLongEdge)
bool execFvgShort = dispShort and not na(execShortEdge)


bool execDistLong = execFvgLong and execLongDist <= C4_MAX_FVG_ATR * atr1
bool execDistShort = execFvgShort and execShortDist <= C4_MAX_FVG_ATR * atr1


bool relLong = execDistLong and not na(relVol5) and relVol5 >= C4_REL5_MIN
bool relShort = execDistShort and not na(relVol5) and relVol5 >= C4_REL5_MIN


float longStopCandidate = low - TICK
float shortStopCandidate = high + TICK


float longRisk = vpVAL - longStopCandidate
float shortRisk = shortStopCandidate - vpVAH


bool riskLong = relLong and longRisk >= C4_MIN_RISK_ATR * atr1
bool riskShort = relShort and shortRisk >= C4_MIN_RISK_ATR * atr1


float longTargetCandidate = vpVAL + 2.0 * longRisk
float shortTargetCandidate = vpVAH - 2.0 * shortRisk


bool roomLong = riskLong and longTargetCandidate < execLongEdge
bool roomShort = riskShort and shortTargetCandidate > execShortEdge




// ============================================================================
// COUNTERS
// ============================================================================


var int qRaw = 0
var int qDisp = 0
var int qAnyFvg = 0
var int qSameFvg = 0
var int qExecFvg = 0
var int qDist = 0
var int qRel = 0
var int qRisk = 0
var int qRoom = 0


var int qLongDisp = 0
var int qShortDisp = 0


if rawLong or rawShort
    qRaw += 1


if dispLong or dispShort
    qDisp += 1


if dispLong
    qLongDisp += 1


if dispShort
    qShortDisp += 1


if anyFvgLong or anyFvgShort
    qAnyFvg += 1


if sameFvgLong or sameFvgShort
    qSameFvg += 1


if execFvgLong or execFvgShort
    qExecFvg += 1


if execDistLong or execDistShort
    qDist += 1


if relLong or relShort
    qRel += 1


if riskLong or riskShort
    qRisk += 1


if roomLong or roomShort
    qRoom += 1




// ============================================================================
// EXECUTION
// ============================================================================


var bool pending = false
var int pendingDir = 0
var int signalBar = na
var float pendingEntry = na
var float pendingStop = na
var float pendingTarget = na
var int activeEntryBar = na


var int qOrders = 0
var int qInvalid = 0
var int qExpired = 0
var int qFills = 0
var int qClosed = 0


bool candidate = not pending and strategy.position_size == 0 and (roomLong or roomShort)


if candidate
    if roomLong
        pendingDir := 1
        pendingEntry := vpVAL
        pendingStop := longStopCandidate
        pendingTarget := longTargetCandidate
    else
        pendingDir := -1
        pendingEntry := vpVAH
        pendingStop := shortStopCandidate
        pendingTarget := shortTargetCandidate


    signalBar := bar_index


    int qty = f_qty(pendingEntry, pendingStop, C4_RISK_USD)


    if qty > 0
        pending := true
        qOrders += 1


        if pendingDir == 1
            strategy.entry(
                 "C4",
                 strategy.long,
                 qty = qty,
                 limit = pendingEntry,
                 comment = "C4"
            )
        else
            strategy.entry(
                 "C4",
                 strategy.short,
                 qty = qty,
                 limit = pendingEntry,
                 comment = "C4"
            )


        strategy.exit(
             "C4-X",
             "C4",
             stop = pendingStop,
             limit = pendingTarget
        )




if pending and strategy.position_size == 0
    int age = bar_index - signalBar


    bool invalid = false


    if pendingDir == 1
        invalid := close < pendingEntry - TICK
    else
        invalid := close > pendingEntry + TICK


    if invalid
        strategy.cancel("C4")
        pending := false
        qInvalid += 1


    else if age > C4_RETEST_MAX
        strategy.cancel("C4")
        pending := false
        qExpired += 1


    else
        strategy.exit(
             "C4-X",
             "C4",
             stop = pendingStop,
             limit = pendingTarget
        )




bool justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0


if justOpened
    pending := false
    activeEntryBar := bar_index
    qFills += 1




if strategy.position_size != 0
    strategy.exit(
         "C4-X",
         "C4",
         stop = pendingStop,
         limit = pendingTarget
    )


    if not na(activeEntryBar)
        if bar_index - activeEntryBar >= C4_MAX_HOLD
            strategy.close("C4", comment = "C4 TIME")




if ctMinute >= 14 * 60 + 59
    if strategy.position_size != 0
        strategy.close("C4", comment = "C4 FLAT")


    if pending
        strategy.cancel("C4")
        pending := false




int priorClosed = nz(strategy.closedtrades[1], 0)


if strategy.closedtrades > priorClosed
    qClosed += strategy.closedtrades - priorClosed
    activeEntryBar := na




// ============================================================================
// VISUALS
// ============================================================================


plot(
     SHOW_LEVELS ? vpVAH : na,
     "Frozen VAH",
     color = color.new(color.red, 50),
     style = plot.style_stepline
)


plot(
     SHOW_LEVELS ? vpVAL : na,
     "Frozen VAL",
     color = color.new(color.green, 50),
     style = plot.style_stepline
)


plot(
     SHOW_LEVELS ? vpPOC : na,
     "Frozen POC",
     color = color.new(color.orange, 35),
     style = plot.style_stepline
)


plotshape(
     SHOW_EVENTS and rawLong,
     title = "RAW Long",
     style = shape.triangleup,
     location = location.belowbar,
     size = size.tiny,
     text = "R"
)


plotshape(
     SHOW_EVENTS and rawShort,
     title = "RAW Short",
     style = shape.triangledown,
     location = location.abovebar,
     size = size.tiny,
     text = "R"
)


plotshape(
     SHOW_EVENTS and execFvgLong,
     title = "FVG Long",
     style = shape.circle,
     location = location.belowbar,
     size = size.tiny,
     text = "F"
)


plotshape(
     SHOW_EVENTS and execFvgShort,
     title = "FVG Short",
     style = shape.circle,
     location = location.abovebar,
     size = size.tiny,
     text = "F"
)




// ============================================================================
// MOBILE PARITY DASHBOARD
// ============================================================================


var table dash = table.new(position.top_right, 4, 31, border_width = 1)


if SHOW_DASH and barstate.islast
    float pfNow = f_pf()


    table.cell(dash, 0, 0, "ZAC v1.2")
    table.cell(dash, 1, 0, "FVG FIX")
